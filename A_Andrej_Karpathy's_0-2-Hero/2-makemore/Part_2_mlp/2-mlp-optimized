":"JoyceL U","userId":"15152067095379831731"}}},"outputs":[],"source":["import torch\n","import torch.nn.functional as F\n","import matplotlib.pyplot as plt # for making figures\n","%matplotlib inline"]},{"cell_type":"code","execution_count":5,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"xc-zfmdZaWD3","executionInfo":{"status":"ok","timestamp":1744014114615,"user_tz":-480,"elapsed":14,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"088168e5-246e-4486-dcbc-5a3214687b55"},"outputs":[{"output_type":"stream","name":"stdout","text":["['emma', 'olivia', 'ava', 'isabella', 'sophia', 'charlotte', 'mia', 'amelia']\n","32033\n"]}],"source":["words = open('names.txt', 'r').read().splitlines()\n","print(words[:8])\n","print(len(words))"]},{"cell_type":"code","execution_count":6,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"OTA2RvS9aXDu","executionInfo":{"status":"ok","timestamp":1744014116183,"user_tz":-480,"elapsed":10,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"5fd6fc71-9c0f-4389-ef11-18c2d6ef19b0"},"outputs":[{"output_type":"stream","name":"stdout","text":["{1: 'a', 2: 'b', 3: 'c', 4: 'd', 5: 'e', 6: 'f', 7: 'g', 8: 'h', 9: 'i', 10: 'j', 11: 'k', 12: 'l', 13: 'm', 14: 'n', 15: 'o', 16: 'p', 17: 'q', 18: 'r', 19: 's', 20: 't', 21: 'u', 22: 'v', 23: 'w', 24: 'x', 25: 'y', 26: 'z', 0: '.'}\n","27\n"]}],"source":["# Build vocabulary of characters and mappings to/from integers\n","chars = sorted(list(set(''.join(words))))\n","stoi = {s:i+1 for i,s in enumerate(chars)}\n","stoi['.'] = 0\n","itos = {i:s for s,i in stoi.items()}\n","vocab_size = len(itos)\n","print(itos)\n","print(vocab_size)"]},{"cell_type":"code","execution_count":7,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"pv1hbjqvcPo4","executionInfo":{"status":"ok","timestamp":1744014119784,"user_tz":-480,"elapsed":715,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"65fe3e3e-bdf4-46ac-a5af-8994517d96f5"},"outputs":[{"output_type":"stream","name":"stdout","text":["torch.Size([182625, 3]) torch.Size([182625])\n","torch.Size([22655, 3]) torch.Size([22655])\n","torch.Size([22866, 3]) torch.Size([22866])\n"]}],"source":["# build the dataset\n","block_size = 3 # context length: how many characters do we take to predict the next one?\n","\n","def build_dataset(words):\n","  X, Y = [], []\n","\n","  for w in words:\n","    context = [0] * block_size\n","    for ch in w + '.':\n","      ix = stoi[ch]\n","      X.append(context)\n","      Y.append(ix)\n","      context = context[1:] + [ix] # crop and append\n","\n","  X = torch.tensor(X)\n","  Y = torch.tensor(Y)\n","  print(X.shape, Y.shape)\n","  return X, Y\n","\n","import random\n","random.seed(42)\n","random.shuffle(words)\n","n1 = int(0.8*len(words))\n","n2 = int(0.9*len(words))\n","\n","Xtr,  Ytr  = build_dataset(words[:n1])     # 80%\n","Xdev, Ydev = build_dataset(words[n1:n2])   # 10%\n","Xte,  Yte  = build_dataset(words[n2:])     # 10%"]},{"cell_type":"markdown","metadata":{"id":"DKeddF07aNG3"},"source":["# MLP - Optimized"]},{"cell_type":"markdown","metadata":{"id":"YRXt5aRMaPSP"},"source":["This is the MLP from Part 2, but certain parts are optimized.\n","\n","Cleaned up initializer and added variables for parameters instead of hardcoding `n_embd`, `n_hidden`."]},{"cell_type":"code","execution_count":7,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"zW_Bt4tmYuH7","executionInfo":{"status":"ok","timestamp":1744009640106,"user_tz":-480,"elapsed":19,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"17e482fe-76d9-4411-9155-9073c3b9251f"},"outputs":[{"output_type":"stream","name":"stdout","text":["11897\n"]}],"source":["# MLP Revisited\n","n_embd = 10 # Dimensionality of character embedding vectors\n","n_hidden = 200 # Number of neurons in hidden layer of MLP\n","\n","g = torch.Generator().manual_seed(2147483647)\n","C = torch.randn((vocab_size, n_embd), generator=g)\n","W1 = torch.randn((n_embd*block_size, n_hidden), generator=g) # 6-> 30\n","b1 = torch.randn(n_hidden, generator=g)\n","W2 = torch.randn((n_hidden,vocab_size), generator=g)\n","b2 = torch.randn(vocab_size, generator=g)\n","\n","parameters = [C, W1, b1, W2, b2]\n","print(sum(p.nelement() for p in parameters))\n","for p in parameters:\n","  p.requires_grad = True"]},{"cell_type":"code","execution_count":8,"metadata":{"id":"gQlrfqEKaF6W","executionInfo":{"status":"ok","timestamp":1744009641236,"user_tz":-480,"elapsed":1118,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}}},"outputs":[],"source":["emb = C[Xtr] # (32, 3, 2)\n","h = torch.tanh(emb.view(-1, 30) @ W1 + b1) # (32, 100)\n","logits = h @ W2 + b2\n","loss = F.cross_entropy(logits, Ytr)"]},{"cell_type":"markdown","metadata":{"id":"EGh9cpDveVHG"},"source":["## Model 1"]},{"cell_type":"markdown","metadata":{"id":"YWLM5520lWw7"},"source":["Train the model"]},{"cell_type":"code","execution_count":9,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"4SrLqt0ZedTz","executionInfo":{"status":"ok","timestamp":1744009654451,"user_tz":-480,"elapsed":13216,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"984eb67d-edd3-49cf-808d-587fb29646b3"},"outputs":[{"output_type":"stream","name":"stdout","text":["      0/  10000: 27.8817\n"]}],"source":["# Same optimization as last time\n","# max_steps = 200000\n","max_steps = 10000\n","batch_size = 32\n","lossi = []\n","\n","for i in range(max_steps):\n","\n","  # Minibatch construct\n","  ix = torch.randint(0, Xtr.shape[0], (batch_size,), generator=g)\n","  Xb, Yb = Xtr[ix], Ytr[ix] # Batch X,Y\n","\n","  # Forward pass\n","  emb = C[Xb] # Embed characters into vectors\n","  embcat = emb.view(emb.shape[0], -1) # Concatenate the vectors\n","  hpreact = embcat @ W1 + b1 # Hidden layer pre-activation\n","  h = torch.tanh(hpreact) # Hidden layer\n","  logits = h @ W2 + b2 # Output layer\n","  loss = F.cross_entropy(logits, Yb) # Loss function\n","\n","  # Backward pass\n","  for p in parameters:\n","    p.grad = None\n","  loss.backward()\n","\n","  # Update\n","  lr = 0.1 if i < 100000 else 0.01 # Step learning rate decay\n","  for p in parameters:\n","    p.data += -lr * p.grad\n","\n","  # Track stats\n","  if i % 10000 == 0: # Print\n","    print(f'{i:7d}/{max_steps:7d}: {loss.item():.4f}')\n","  lossi.append(loss.log10().item())"]},{"cell_type":"code","execution_count":10,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":448},"id":"V165hZczkNHM","executionInfo":{"status":"ok","timestamp":1744009654619,"user_tz":-480,"elapsed":180,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"1af92aab-42e0-4611-d34b-73f37163f50e"},"outputs":[{"output_type":"execute_result","data":{"text/plain":["[<matplotlib.lines.Line2D at 0x7a7a79cf7710>]"]},"metadata":{},"execution_count":10},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["plt.plot(lossi)"]},{"cell_type":"markdown","metadata":{"id":"RvwoWLzNlUaE"},"source":["Test the model"]},{"cell_type":"code","execution_count":11,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"op6NsaeikaPB","executionInfo":{"status":"ok","timestamp":1744009655199,"user_tz":-480,"elapsed":579,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"9ecc6935-c7d9-4d9f-8ba2-c0c6694ae489"},"outputs":[{"output_type":"stream","name":"stdout","text":["train 2.5752944946289062\n","val 2.5866687297821045\n"]}],"source":["@torch.no_grad() # This decorator disables gradient tracking\n","def split_loss(split):\n","  x, y = {\n","      'train': {Xtr, Ytr},\n","      'val': {Xdev, Ydev},\n","      'test': {Xte, Yte},\n","  } [split]\n","  emb = C[x] # (N, block_size, n_embd)\n","  embcat = emb.view(emb.shape[0], -1) # Concat into (N, block_size + n_embd)\n","  h = torch.tanh(embcat @ W1 + b1) # (N, n_hidden)\n","  logits = h @ W2 + b2 # (N, vocab_size)\n","  loss = F.cross_entropy(logits, y)\n","  print(split, loss.item())\n","\n","split_loss('train')\n","split_loss('val')"]},{"cell_type":"markdown","metadata":{"id":"DD6prD-blVej"},"source":["Sample from model"]},{"cell_type":"code","execution_count":12,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"j_nOD54mlttd","executionInfo":{"status":"ok","timestamp":1744009655232,"user_tz":-480,"elapsed":32,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"4758d5ba-7747-4d69-840a-84090ef56f0c"},"outputs":[{"output_type":"stream","name":"stdout","text":["mri.\n","almyn.\n","ziee.\n","med.\n","rymmaerish.\n","jend.\n","lee.\n","aze.\n","edielii.\n","mai.\n","ren.\n","emee.\n","van.\n","naree.\n","tei.\n","hvara.\n","noshi.\n","vos.\n","hirie.\n","tin.\n"]}],"source":["g = torch.Generator().manual_seed(2147483647 + 10)\n","\n","for _ in range(20):\n","\n","  out = []\n","  context=[0] * block_size # Initialize all with ...\n","  while True:\n","    # Forward pass neural net\n","    emb = C[torch.tensor([context])] # (1, block_size, n_embd)\n","    h = torch.tanh(emb.view(1,-1) @ W1 + b1)\n","    logits = h @ W2 + b2\n","    probs = F.softmax(logits, dim=1)\n","    # Sample from distribution\n","    ix = torch.multinomial(probs, num_samples=1, generator=g).item()\n","    # Shift context window and track the samples\n","    context = context[1:] + [ix]\n","    out.append(ix)\n","    # If sample '.' token, break\n","    if ix == 0:\n","      break\n","\n","  print(''.join(itos[i] for i in out)) # Decode and print the generated words"]},{"cell_type":"markdown","metadata":{"id":"K3kKjBL2nIQ2"},"source":["### Issue - High initial loss"]},{"cell_type":"markdown","metadata":{"id":"b-LFbwRlnJei"},"source":["1. Initial loss at step 0 is way too high at `27.8817`.\n"," - This value is usually expected and calculatable.\n"," - We have 27 characters, so initially the probability of each character is expected to be `1/27` but the <u>loss</u> should be the log of it which is `3.2958`.\n"," - We can think that during initialization, the neural net is creating probability distribution that are messed up such that some characters are often and some are not (higher probability, should be equal).\n"," - The network is very <u>confidently wrong</u>, hence why it recorded a very high loss."]},{"cell_type":"code","execution_count":13,"metadata":{"id":"2IHDlPv4np2y","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1744009655237,"user_tz":-480,"elapsed":4,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"3ed9eb21-3ddf-4b74-9b59-adb4f4848cc6"},"outputs":[{"output_type":"execute_result","data":{"text/plain":["tensor(3.2958)"]},"metadata":{},"execution_count":13}],"source":["-torch.tensor(1/27.0).log()"]},{"cell_type":"markdown","metadata":{"id":"HMOL6NcvpOVP"},"source":["During initialization, the logits should be much closer to 0."]},{"cell_type":"code","execution_count":14,"metadata":{"id":"xkdEiaatpTpo","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1744009655249,"user_tz":-480,"elapsed":10,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"123c40d1-cc01-48bf-ed4c-673eee0d6365"},"outputs":[{"output_type":"stream","name":"stdout","text":["11897\n"]}],"source":["# MLP Revisited\n","n_embd = 10 # Dimensionality of character embedding vectors\n","n_hidden = 200 # Number of neurons in hidden layer of MLP\n","\n","g = torch.Generator().manual_seed(2147483647)\n","C = torch.randn((vocab_size, n_embd), generator=g)\n","W1 = torch.randn((n_embd*block_size, n_hidden), generator=g) # 6-> 30\n","b1 = torch.randn(n_hidden, generator=g)\n","W2 = torch.randn((n_hidden,vocab_size), generator=g)\n","b2 = torch.randn(vocab_size, generator=g)\n","\n","parameters = [C, W1, b1, W2, b2]\n","print(sum(p.nelement() for p in parameters))\n"