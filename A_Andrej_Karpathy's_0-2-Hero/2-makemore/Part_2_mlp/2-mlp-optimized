635965e-01,\n","        -5.19700665e-01, -4.79765366e-01, -4.39830067e-01, -3.99894768e-01,\n","        -3.59959469e-01, -3.20024170e-01, -2.80088871e-01, -2.40153571e-01,\n","        -2.00218272e-01, -1.60282973e-01, -1.20347674e-01, -8.04123747e-02,\n","        -4.04770756e-02, -5.41776419e-04,  3.93935227e-02,  7.93288219e-02,\n","         1.19264121e-01,  1.59199420e-01,  1.99134719e-01,  2.39070019e-01,\n","         2.79005318e-01,  3.18940617e-01,  3.58875916e-01,  3.98811215e-01,\n","         4.38746514e-01,  4.78681813e-01,  5.18617113e-01,  5.58552412e-01,\n","         5.98487711e-01,  6.38423010e-01,  6.78358309e-01,  7.18293608e-01,\n","         7.58228908e-01,  7.98164207e-01,  8.38099506e-01,  8.78034805e-01,\n","         9.17970104e-01,  9.57905403e-01,  9.97840703e-01]),\n"," <BarContainer object of 50 artists>)"]},"metadata":{},"execution_count":33},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["plt.hist(h.view(-1).tolist(), 50)"]},{"cell_type":"code","execution_count":34,"metadata":{"id":"V7A6kP21CRyA","colab":{"base_uri":"https://localhost:8080/","height":328},"executionInfo":{"status":"ok","timestamp":1744009666873,"user_tz":-480,"elapsed":204,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"b3e30f91-50a0-44dd-acfd-cbfd61c404e9"},"outputs":[{"output_type":"execute_result","data":{"text/plain":["<matplotlib.image.AxesImage at 0x7a798e331950>"]},"metadata":{},"execution_count":34},{"output_type":"display_data","data":{"text/plain":["<Figure size 2000x1000 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["plt.figure(figsize=(20,10))\n","plt.imshow(h.abs() > 0.99, cmap='gray', interpolation='nearest')"]},{"cell_type":"markdown","metadata":{"id":"Z-cNBB4ODnid"},"source":["- Changing the W1... * 0.1, there will not be whites.\n","- W1... * 0.2 has a better distribution graph. Is what our initialization should be."]},{"cell_type":"markdown","metadata":{"id":"I0j3UjlsEqly"},"source":["From the video:"]},{"cell_type":"markdown","metadata":{"id":"ygKM0x_hEfz1"},"source":["![image.png](data:image/png;base64,)"]},{"cell_type":"markdown","metadata":{"id":"mV3zuhVwEu8m"},"source":["The deeper and more complex the network, the worse the effect of these errors will show."]},{"cell_type":"markdown","metadata":{"id":"n4VQg44X_qtR"},"source":["---"]},{"cell_type":"markdown","metadata":{"id":"F2xKQHD2E6yg"},"source":["### !! Issue - Initialization - What are those W1... * 0.2 ?"]},{"cell_type":"markdown","metadata":{"id":"5K6fyJ1mFB7v"},"source":["Where do these numbers come from?"]},{"cell_type":"markdown","metadata":{"id":"EBBwAykKYfml"},"source":["<u>We want our standard deviation to be 1 to remain a Gaussian.</u>\n","\n","There is a principal way of setting these initializations.\n","\n","Consider there are 2 initializations of x and w."]},{"cell_type":"code","execution_count":35,"metadata":{"id":"Q_v4pKobZDtz","colab":{"base_uri":"https://localhost:8080/","height":90},"executionInfo":{"status":"ok","timestamp":1744009667858,"user_tz":-480,"elapsed":984,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"d2003e43-f28d-487d-e9e4-d01fd3c949d7"},"outputs":[{"output_type":"stream","name":"stdout","text":["tensor(0.0029) tensor(0.9903)\n","tensor(0.0126) tensor(3.2489)\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 2000x500 with 2 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["x = torch.randn(1000, 10)\n","w = torch.randn(10, 200)\n","y = x @ w\n","print(x.mean(), x.std())\n","print(y.mean(), y.std())\n","plt.figure(figsize=(20, 5))\n","plt.subplot(121)\n","plt.hist(x.view(-1).tolist(), 50, density=True);\n","plt.subplot(122)\n","plt.hist(y.view(-1).tolist(), 50, density=True);"]},{"cell_type":"markdown","metadata":{"id":"SCK6QhPYbPCH"},"source":["The base initialization resulted in standard deviation of 3.113.\n","\n","By multiplying `w` with 2, the std. deviation of `y` will increase/<u>expand</u> by that value."]},{"cell_type":"code","execution_count":36,"metadata":{"id":"svvDDXDedR4H","colab":{"base_uri":"https://localhost:8080/","height":90},"executionInfo":{"status":"ok","timestamp":1744009668686,"user_tz":-480,"elapsed":839,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"d3192194-0c33-4758-de6e-7bd17451489f"},"outputs":[{"output_type":"stream","name":"stdout","text":["tensor(0.0001) tensor(0.9834)\n","tensor(-0.0005) tensor(6.1635)\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 2000x500 with 2 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["x = torch.randn(1000, 10)\n","w = torch.randn(10, 200) * 2\n","y = x @ w\n","print(x.mean(), x.std())\n","print(y.mean(), y.std())\n","plt.figure(figsize=(20, 5))\n","plt.subplot(121)\n","plt.hist(x.view(-1).tolist(), 50, density=True);\n","plt.subplot(122)\n","plt.hist(y.view(-1).tolist(), 50, density=True);"]},{"cell_type":"markdown","metadata":{"id":"QACQ3NA5egdN"},"source":["Similarly by multiplying `w` with 0.2, the std. deviation of `y` will decrease/<u>shrink</u> by that value."]},{"cell_type":"code","execution_count":37,"metadata":{"id":"lteTjhdRdwMe","colab":{"base_uri":"https://localhost:8080/","height":90},"executionInfo":{"status":"ok","timestamp":1744009669481,"user_tz":-480,"elapsed":797,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"3fbdfa3b-5b8f-47b1-aeeb-fe45cf3c7a77"},"outputs":[{"output_type":"stream","name":"stdout","text":["tensor(0.0196) tensor(0.9914)\n","tensor(-0.0006) tensor(0.6295)\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 2000x500 with 2 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["x = torch.randn(1000, 10)\n","w = torch.randn(10, 200) * 0.2\n","y = x @ w\n","print(x.mean(), x.std())\n","print(y.mean(), y.std())\n","plt.figure(figsize=(20, 5))\n","plt.subplot(121)\n","plt.hist(x.view(-1).tolist(), 50, density=True);\n","plt.subplot(122)\n","plt.hist(y.view(-1).tolist(), 50, density=True);"]},{"cell_type":"markdown","metadata":{"id":"NJ7KRChOfr02"},"source":["### Solution - Fan in and Kaiming init"]},{"cell_type":"markdown","metadata":{"id":"p3qxqSBmfAau"},"source":["<u>**Question - What do I multiply so the std. dev. be exactly equal to 1?**"]},{"cell_type":"markdown","metadata":{"id":"Kj80Tz6ufIh-"},"source":["The solution, mathematically is to <u>divide the **square root of fan in**</u>\n","\n","fan in = number of input element"]},{"cell_type":"code","execution_count":38,"metadata":{"id":"9qKo7ZcQfdFP","colab":{"base_uri":"https://localhost:8080/","height":90},"executionInfo":{"status":"ok","timestamp":1744009670268,"user_tz":-480,"elapsed":787,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"6e1e1c16-eac7-4867-bbac-29f8f4ebad4f"},"outputs":[{"output_type":"stream","name":"stdout","text":["tensor(-0.0062) tensor(1.0029)\n","tensor(-0.0003) tensor(0.9867)\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 2000x500 with 2 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["x = torch.randn(1000, 10)\n","w = torch.randn(10, 200) / 10**0.5\n","y = x @ w\n","print(x.mean(), x.std())\n","print(y.mean(), y.std())\n","plt.figure(figsize=(20, 5))\n","plt.subplot(121)\n","plt.hist(x.view(-1).tolist(), 50, density=True);\n","plt.subplot(122)\n","plt.hist(y.view(-1).tolist(), 50, density=True);"]},{"cell_type":"markdown","metadata":{"id":"dubDq7bTgYoJ"},"source":["#### Kaiming init\n","\n","[doc](https://arxiv.org/abs/1502.01852)"]},{"cell_type":"markdown","metadata":{"id":"9qIGes9MglJe"},"source":["The paper explains that activation functions has squashing functions (e.g.ReLU squashes / zeroes all negative numbers, tanh squashes to 1 or -1).\n","\n","In order to compensate for that squashing function, initialization needs to have <u>gain<u>.\n","\n","<u>Moreover, if forward pass is properly initialized, backward pass is also approximately initialized up to a constant factor of size of hidden neurons in early and late layer.</u>\n","\n","[Kaiming init is implemented in pytorch.](https://pytorch.org/docs/stable/nn.init.html)"]},{"cell_type":"markdown","metadata":{"id":"JiGs8VvRiQvr"},"source":["**Note: Different nonlinearity has different gain**"]},{"cell_type":"markdown","metadata":{"id":"ToPgsy6Ric3E"},"source":["![image.png](data:image/png;base64,)"]},{"cell_type":"markdown","metadata":{"id":"o9ntgUhbidjT"},"source":["Image obtained from pytorch's init (provided above)"]},{"cell_type":"markdown","metadata":{"id":"nDlkBEYlirGl"},"source":["#### Some history on init and why some pre-initialization steps are made currently."]},{"cell_type":"markdown","metadata":{"id":"CHY6-uHzixzj"},"source":["As of discussion until current, initiation for models is as important as activation function chosen, as seen from examples above. Weight initialization with gains affects the std variation of the output which is dependent on which nonlinearity chosen, similarly for back pass."]},{"cell_type":"markdown","metadata":{"id":"tUltaZufjNtQ"},"source":["<u>Modern innovations such as batch normalization trivializes efforts mentioned above, avoiding the need to precisely initialize the network.</u>\n","\n","Examples\n","1. Residual connection (ResNet) method\n","2. Normalization layers (e.g. Batch, Layer, Group Normalization)\n","3. Better optimizers;\n","\n","Not just stochastic gradient descent, complex optimizers such as ARS prop, ADAM."]},{"cell_type":"markdown","metadata":{"id":"Lrzvjl83j4jx"},"source":["---\n","\n","As such with modern innovations, we can just normalize the weights by square root of fan in."]},{"cell_type":"markdown","metadata":{"id":"PY_8cIShkIkC"},"source":["![image.png](data:image/png;base64,)"]},{"cell_type":"markdown","metadata":{"id":"uzVNIDUekJSq"},"source":["Calculating the initialization (Reminder that our fan in is 3*10)"]},{"cell_type":"code","execution_count":39,"metadata":{"id":"7vCIP4ZnkKwL","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1744009670272,"user_tz":-480,"elapsed":3,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"9c7ae674-17a1-4a89-f89a-9b22e3a8348d"},"outputs":[{"output_type":"execute_result","data":{"text/plain":["0.3042903097250923"]},"metadata":{},"execution_count":39}],"source":["(5/3)/(30**0.5)"]},{"cell_type":"markdown","metadata":{"id":"KwsJMGvblgcj"},"source":["And such our initialization should be"]},{"cell_type":"code","execution_count":40,"metadata":{"id":"V3jk-j_XlmUm","executionInfo":{"status":"ok","timestamp":1744009670274,"user_tz":-480,"elapsed":1,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}}},"outputs":[],"source":["W1 = torch.randn((n_embd*block_size, n_hidden), generator=g) * (5/3)/(30**0.5)\n","W1 = torch.randn((n_embd*block_size, n_hidden), generator=g) * (5/3)/(n_embd*block_size**0.5)"]},{"cell_type":"markdown","metadata":{"id":"K2_RqoKmmV5K"},"source":["## Model 2 - Batch Normalization"]},{"cell_type":"markdown","metadata":{"id":"WEA3XR7PaFpj"},"source":["[paper](https://arxiv.org/abs/1502.03167)"]},{"cell_type":"markdown","metadata":{"id":"nBrcVIXCaHrO"},"source":["Batch Normalization's invention made it possible to train deep neural network more <u>efficiently</u>.\n","\n","Reminder: We do not want H pre-activation states to be too small, else the tanh is not doing anything (-1.0); too large, else the tanh is saturated (1.0). <u>We want them to be roughly Gaussian (mean=0; std.dev=1.0).</u>\n","\n","Batch Normalization:\n","- <u>Take hidden states and normalize them to be Gaussian.</u>"]},{"cell_type":"markdown","metadata":{"id":"COqeAYiXbSUf"},"source":["To do so, we need to"]},{"cell_type":"markdown","source":["![image.png](data:image/png;base64,)"],"metadata":{"id":"v_Xk8JAvceu4"}},{"cell_type":"markdown","source":["Step 1: Standardizing activation at any point in network\n","```\n","  # New: Batch Normalization\n","  # Make hpreact Gaussian:\n","  hpreact = embcat @ W1 + b1 # Hidden layer pre-activation #([32,200])\n","  hpreact = (hpreact - hpreact.mean(0, keepdim=True)) / hpreact.std(0, keepdim=True) # mini-batch normalization\n","```"],"metadata":{"id":"cQzyFVNzc-pN"}},{"cell_type":"markdown","source":["**However, this will not output good result** because <u>We want these to be roughly Gaussian but only at _initialization_ and _not always forced to be Gaussian_</u>"],"metadata":{"id":"X1toO64sdCL6"}},{"cell_type":"markdown","source":["---\n","\n","Step 2: Scale and shift - Gains and Offset\n","\n","_Scale the normalized inputs by some gains and offseting them by some bias to get the final output from this layer._"],"metadata":{"id":"2ZP3mU8Ndgqq"}},{"cell_type":"markdown","source":["```\n","W1 = torch.randn((n_embd*block_size, n_hidden), generator=g)  * (5/3)/(n_embd*block_size**0.5)\n","b1 = torch.randn(n_hidden,                      generator=g)  * 0.01\n","W2 = torch.randn((n_hidden,vocab_size),         generator=g)  * 0.01\n","b2 = torch.randn(vocab_size,                    generator=g)  * 0\n","\n","# New: Scale and shift\n","bngain = torch.ones((1, n_hidden))\n","bnbias = torch.zeros((1, n_hidden))\n","parameters = [C, W1, b1, W2, b2, bngain, bnbias]\n","```\n","\n","---\n","\n","```\n","  # New: Batch Normalization\n","  # Make hpreact Gaussian:\n","  hpreact = embcat @ W1 + b1 # Hidden layer pre-activation #([32,200])\n","  hpreact = bngain * (hpreact - hpreact.mean(0, keepdim=True)) / hpreact.std(0, keepdim=True) + bnbias\n","```"],"metadata":{"id":"_qIkYPsVeFVM"}},{"cell_type":"markdown","source":["![image.png](data:image/png;base64,)"],"metadata":{"id":"sjdZ7IFEe37X"}},{"cell_type":"markdown","source":["Because `bngain` is init to 1 and `bnbias` is init to 0, at initialization, each neuron's firing value in this batch will be exactly unit Gaussian.\n","\n","During back pass, bngain and bnbias will be optimized as well.\n","\n","Note:\n","_Batch normalization happened to have regularization effect (at hpreact scale and shift), effectively padding out or introducing noise/entropy to the network; reducing the likelihood of overfitting._\n","\n","\n","_It has been hard to remove batch normalization layer from current models because it works so well; with the regularization effect and is effective at controlling activations and distributions of neurons._"],"metadata":{"id":"P5Cmc3B6fEmk"}},{"cell_type":"markdown","metadata":{"id":"n_Z1WblPbRqe"},"source":["---"]},{"cell_type":"code","execution_count":41,"metadata":{"id":"C9wpuUZvmZGH","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1744009670285,"user_tz":-480,"elapsed":10,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"545cc352-4b3c-442c-bfa6-5e3a693133da"},"outputs":[{"output_type":"stream","name":"stdout","text":["12297\n"]}],"source":["# MLP Revisited\n","n_embd = 10 # Dimensionality of character embedding vectors\n","n_hidden = 200 # Number of neurons in hidden layer of MLP\n","\n","g = torch.Generator().manual_seed(2147483647)\n","C = torch.randn((vocab_size, n_embd), generator=g)\n","W1 = torch.randn((n_embd*block_size, n_hidden), generator=g)  * (5/3)/(n_embd*block_size**0.5)\n","b1 = torch.randn(n_hidden,                      generator=g)  * 0.01\n","W2 = torch.randn((n_hidden,vocab_size),         generator=g)  * 0.01\n","b2 = torch.randn(vocab_size,                    generator=g)  * 0\n","\n","# New: Scale and shift\n","bngain = torch.ones((1, n_hidden))\n","bnbias = torch.zeros((1, n_hidden))\n","\n","parameters = [C, W1, b1, W2, b2, bngain, bnbias]\n","print(sum(p.nelement() for p in parameters))\n","for p in parameters:\n","  p.requires_grad = True"]},{"cell_type":"code","execution_count":42,"metadata":{"id":"o9D5AcWHa9mD","executionInfo":{"status":"ok","timestamp":1744009670834,"user_tz":-480,"elapsed":547,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}}},"outputs":[],"source":["emb = C[Xtr] # (32, 3, 2)\n","h = torch.tanh(emb.view(-1, 30) @ W1 + b1) # (32, 100)\n","logits = h @ W2 + b2\n","loss = F.cross_entropy(logits, Ytr)"]},{"cell_type":"code","execution_count":43,"metadata":{"id":"0O2SpuBAbB3G","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1744009698855,"user_tz":-480,"elapsed":28023,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"94339c50-b47b-420c-a1f4-514ce87ee86b"},"outputs":[{"output_type":"stream","name":"stdout","text":["      0/  20000: 3.3147\n","  10000/  20000: 2.0977\n"]}],"source":["# Same optimization as last time\n","# max_steps = 200000\n","max_steps = 20000\n","batch_size = 32\n","lossi = []\n","\n","for i in range(max_steps):\n","\n","  # Minibatch construct\n","  ix = torch.randint(0, Xtr.shape[0], (batch_size,), generator=g)\n","  Xb, Yb = Xtr[ix], Ytr[ix] # Batch X,Y\n","\n","  # Forward pass\n","  emb = C[Xb] # Embed characters into vectors\n","  embcat = emb.view(emb.shape[0], -1) # Concatenate the vectors\n","\n","  # New: Batch Normalization\n","  # Make hpreact Gaussian:\n","  hpreact = embcat @ W1 + b1 # Hidden layer pre-activation #([32,200])\n","  hpreact = bngain * (hpreact - hpreact.mean(0, keepdim=True)) / hpreact.std(0, keepdim=True) + bnbias # mini-batch norm\n","\n","  h = torch.tanh(hpreact) # Hidden layer\n","  logits = h @ W2 + b2 # Output layer\n","  loss = F.cross_entropy(logits, Yb) # Loss function\n","\n","  # Backward pass\n","  for p in parameters:\n","    p.grad = None\n","  loss.backward()\n","\n","  # Update\n","  lr = 0.1 if i < 100000 else 0.01 # Step learning rate decay\n","  for p in parameters:\n","    p.data += -lr * p.grad\n","\n","  # Track stats\n","  if i % 10000 == 0: # Print\n","    print(f'{i:7d}/{max_steps:7d}: {loss.item():.4f}')\n","  lossi.append(loss.log10().item())\n","  # break"]},{"cell_type":"code","source":["@torch.no_grad() # This decorator disables gradient tracking\n","def split_loss(split):\n","  x, y = {\n","      'train': {Xtr, Ytr},\n","      'val': {Xdev, Ydev},\n","      'test': {Xte, Yte},\n","  } [split]\n","  emb = C[x] # (N, block_size, n_embd)\n","  embcat = emb.view(emb.shape[0], -1) # Concat into (N, block_size + n_embd)\n","  hpreact = embcat @ W1 + b1\n","  hpreact = bngain * (hpreact - hpreact.mean(0, keepdim=True)) / hpreact.std(0, keepdim=True) + bnbias\n","  h = torch.tanh(hpreact) # (N, n_hidden)\n","  logits = h @ W2 + b2 # (N, vocab_size)\n","  loss = F.cross_entropy(logits, y)\n","  print(split, loss.item())\n","\n","split_loss('train')\n","split_loss('val')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"foW_YKzBf9yS","executionInfo":{"status":"ok","timestamp":1744009700890,"user_tz":-480,"elapsed":2031,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"0053c645-2d09-48b9-c014-ad4988a9f089"},"execution_count":44,"outputs":[{"output_type":"stream","name":"stdout","text":["train 2.207956075668335\n","val 2.2270328998565674\n"]}]},{"cell_type":"code","source":["plt.plot(lossi)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":448},"id":"CVTJvaU2jhhd","executionInfo":{"status":"ok","timestamp":1744009701433,"user_tz":-480,"elapsed":540,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"14787e9c-c909-4716-b219-ec5e2b8a5ac5"},"execution_count":45,"outputs":[{"output_type":"execute_result","data":{"text/plain":["[<matplotlib.lines.Line2D at 0x7a798d5195d0>]"]},"metadata":{},"execution_count":45},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["### Issue - Input has been in batches, how to give a single input?"],"metadata":{"id":"bVX-8WdjmejT"}},{"cell_type":"markdown","source":["Solution -\n","\n","Have a step _after_ training, that **_calculates and sets the batch mean and std deviation a single time, instead of batch_ via <u>calibration of batch norm at the end of training.</u>**"],"metadata":{"id":"v1ASve8nnAAd"}},{"cell_type":"code","source":["# Calibrate the batch norm at the end of training\n","with torch.no_grad():\n","  # Pass the training set through\n","  emb = C[Xtr]\n","  embcat = emb.view(emb.shape[0], -1)\n","  hpreact = embcat @ W1 # + b1\n","  # Measure the mean/std over the entire training set\n","  bnmean = hpreact.mean(0, keepdim=True)\n","  bnstd = hpreact.std(0, keepdim=True)"],"metadata":{"id":"BmlVup1tnUJO","executionInfo":{"status":"ok","timestamp":1744009702069,"user_tz":-480,"elapsed":635,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}}},"execution_count":46,"outputs":[]},{"cell_type":"markdown","source":["bnmean and bnstd are now fixed to be used during inference."],"metadata":{"id":"Blw66SpHngKY"}},{"cell_type":"code","source":["@torch.no_grad() # This decorator disables gradient tracking\n","def split_loss(split):\n","  x, y = {\n","      'train': {Xtr, Ytr},\n","      'val': {Xdev, Ydev},\n","      'test': {Xte, Yte},\n","  } [split]\n","  emb = C[x] # (N, block_size, n_embd)\n","  embcat = emb.view(emb.shape[0], -1) # Concat into (N, block_size + n_embd)\n","  hpreact = embcat @ W1 + b1\n","  hpreact = bngain * (hpreact - bnmean) / bnstd + bnbias\n","  h = torch.tanh(hpreact) # (N, n_hidden)\n","  logits = h @ W2 + b2 # (N, vocab_size)\n","  loss = F.cross_entropy(logits, y)\n","  print(split, loss.item())\n","\n","split_loss('train')\n","split_loss('val')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"XoFcWn17nWWA","executionInfo":{"status":"ok","timestamp":1744009703337,"user_tz":-480,"elapsed":1263,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"584d9d1b-ab6c-4373-bfe7-ffcda94991f4"},"execution_count":47,"outputs":[{"output_type":"stream","name":"stdout","text":["train 2.208098888397217\n","val 2.227508544921875\n"]}]},{"cell_type":"markdown","source":["### Solution - Estimate mean and std in a running manner during training"],"metadata":{"id":"flZsj5P8n2EI"}},{"cell_type":"markdown","source":["What is introduced in issue, introduces a second stage that can be removed by estimating the running mean and std.\n","\n","Basically put the `bnmean` and `bnstd` into training code.\n","\n","Note: _Updating running mean and std, SHOULD NOT be updated via gradient based optimization, don't derive their gradients!_\n","\n","Basically no need to calibrate."],"metadata":{"id":"sYW3JxD4n9og"}},{"cell_type":"code","source":["# MLP Revisited\n","n_embd = 10 # Dimensionality of character embedding vectors\n","n_hidden = 200 # Number of neurons in hidden layer of MLP\n","\n","g = torch.Generator().manual_seed(2147483647)\n","C = torch.randn((vocab_size, n_embd), generator=g)\n","W1 = torch.randn((n_embd*block_size, n_hidden), generator=g)  * (5/3)/(n_embd*block_size**0.5)\n","b1 = torch.randn(n_hidden,                      generator=g)  * 0.01\n","W2 = torch.randn((n_hidden,vocab_size),         generator=g)  * 0.01\n","b2 = torch.randn(vocab_size,                    generator=g)  * 0\n","\n","bngain = torch.ones((1, n_hidden))\n","bnbias = torch.zeros((1, n_hidden))\n","# New: Running mean and std saving\n","bnmean_running = torch.zeros((1, n_hidden))\n","bnstd_running  = torch.ones((1, n_hidden))\n","\n","\n","parameters = [C, W1, b1, W2, b2, bngain, bnbias]\n","print(sum(p.nelement() for p in parameters))\n","for p in parameters:\n","  p.requires_grad = True"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ypGSHYDIoP3w","executionInfo":{"status":"ok","timestamp":1744009703349,"user_tz":-480,"elapsed":11,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"110fbdf9-0de2-49e6-ce4e-4d25832d56ba"},"execution_count":48,"outputs":[{"output_type":"stream","name":"stdout","text":["12297\n"]}]},{"cell_type":"code","source":["emb = C[Xtr] # (32, 3, 2)\n","h = torch.tanh(emb.view(-1, 30) @ W1 + b1) # (32, 100)\n","logits = h @ W2 + b2\n","loss = F.cross_entropy(logits, Ytr)"],"metadata":{"id":"wWwbBdXboSQY","executionInfo":{"status":"ok","timestamp":1744009703899,"user_tz":-480,"elapsed":549,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}}},"execution_count":49,"outputs":[]},{"cell_type":"code","source":["# Same optimization as last time\n","# max_steps = 200000\n","max_steps = 30000\n","batch_size = 32\n","lossi = []\n","\n","for i in range(max_steps):\n","\n","  # Minibatch construct\n","  ix = torch.randint(0, Xtr.shape[0], (batch_size,), generator=g)\n","  Xb, Yb = Xtr[ix], Ytr[ix] # Batch X,Y\n","\n","  # Forward pass\n","  emb = C[Xb] # Embed characters into vectors\n","  embcat = emb.view(emb.shape[0], -1) # Concatenate the vectors\n","  hpreact = embcat @ W1 + b1 # Hidden layer pre-activation #([32,200])\n","\n","  # New: Running mean and std estimation\n","  bnmeani = hpreact.mean(0, keepdim=True)\n","  bnstdi  = hpreact.std(0, keepdim=True)\n","  hpreact = bngain * (hpreact - bnmeani) / bnstdi + bnbias # mini-batch norm\n","\n","  # Running should not be optimized via gradient.\n","  # It is final product of network.\n","  with torch.no_grad():\n","    bnmean_running = 0.999 * bnmean_running + 0.001 * bnmeani\n","    bnstd_running = 0.999 * bnstd_running + 0.001 * bnstdi\n","\n","  h = torch.tanh(hpreact) # Hidden layer\n","  logits = h @ W2 + b2 # Output layer\n","  loss = F.cross_entropy(logits, Yb) # Loss function\n","\n","  # Backward pass\n","  for p in parameters:\n","    p.grad = None\n","  loss.backward()\n","\n","  # Update\n","  lr = 0.1 if i < 100000 else 0.01 # Step learning rate decay\n","  for p in parameters:\n","    p.data += -lr * p.grad\n","\n","  # Track stats\n","  if i % 10000 == 0: # Print\n","    print(f'{i:7d}/{max_steps:7d}: {loss.item():.4f}')\n","  lossi.append(loss.log10().item())\n","  # break"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Heidow7FoXRd","executionInfo":{"status":"ok","timestamp":1744009744781,"user_tz":-480,"elapsed":40880,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"73961d02-cec2-4d84-975e-bf5d23c7fa3b"},"execution_count":50,"outputs":[{"output_type":"stream","name":"stdout","text":["      0/  30000: 3.3147\n","  10000/  30000: 2.0977\n","  20000/  30000: 2.3415\n"]}]},{"cell_type":"markdown","source":["### Mini notes about Batch Normalization"],"metadata":{"id":"5EUNCeNqqjLO"}},{"cell_type":"markdown","source":["1. What is the epsilon in normalize step?"],"metadata":{"id":"uFtJgboHqlon"}},{"cell_type":"markdown","source":["![image.png](data:image/png;base64,)"],"metadata":{"id":"6RdoDvAiqr2g"}},{"cell_type":"markdown","source":["Ans: A very small value that prevents means of division by 0. Is commonly used whenever an operation has a chance to divide by 0."],"metadata":{"id":"Lzf7wFRrqsWt"}},{"cell_type":"markdown","source":["2. The bias `b1` is actually not doing anything\n","- We added `b1` to `hpreact` (`hpreact = embcat @ W1 + b1`) but we are also calculating `hpreact.mean`, then subtracting it (`(hpreact - bnmeani)`)\n","- i.e. biases added in `hpreact` is going to get subracted in `bnmeani`.\n","- `b1.grad = 0`"],"metadata":{"id":"oGvVKQbQrUkd"}},{"cell_type":"code","source":["b1.grad[:5]"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"km3DZLVkraRk","executionInfo":{"status":"ok","timestamp":1744009744799,"user_tz":-480,"elapsed":13,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"2a0c8d1f-8f63-4c9f-fc87-6d6a284de65c"},"execution_count":51,"outputs":[{"output_type":"execute_result","data":{"text/plain":["tensor([-2.3283e-10,  2.3283e-10, -2.7940e-09,  2.3283e-10, -1.5134e-09])"]},"metadata":{},"execution_count":51}]},{"cell_type":"markdown","source":["**Note**:\n","\n","_If weight layer exists (such as linear layer) before Batch Normalization layers is used, don't need to use bias in the weight layer_.\n","\n","```\n","  hpreact = embcat @ W1 #+ b1 # Hidden layer pre-activation #([32,200])\n","\n","```"],"metadata":{"id":"9dQZhfs6sMh5"}},{"cell_type":"markdown","source":["# Summary code"],"metadata":{"id":"yZBgb1sugZaZ"}},{"cell_type":"code","source":["# MLP Revisited\n","n_embd = 10 # Dimensionality of character embedding vectors\n","n_hidden = 200 # Number of neurons in hidden layer of MLP\n","\n","g = torch.Generator().manual_seed(2147483647)\n","C = torch.randn((vocab_size, n_embd), generator=g)\n","W1 = torch.randn((n_embd*block_size, n_hidden), generator=g)  * (5/3)/(n_embd*block_size**0.5)\n","b1 = torch.randn(n_hidden,                      generator=g)  * 0.01\n","W2 = torch.randn((n_hidden,vocab_size),         generator=g)  * 0.01\n","b2 = torch.randn(vocab_size,                    generator=g)  * 0\n","\n","bngain = torch.ones((1, n_hidden))\n","bnbias = torch.zeros((1, n_hidden))\n","# New: Running mean and std saving\n","bnmean_running = torch.zeros((1, n_hidden))\n","bnstd_running  = torch.ones((1, n_hidden))\n","\n","\n","parameters = [C, W1, b1, W2, b2, bngain, bnbias]\n","print(sum(p.nelement() for p in parameters))\n","for p in parameters:\n","  p.requires_grad = True"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"s0z_0WzafewQ","executionInfo":{"status":"ok","timestamp":1744009744810,"user_tz":-480,"elapsed":6,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"b0e3bf19-af20-4d5f-bcc6-a4fe41cd6a13"},"execution_count":52,"outputs":[{"output_type":"stream","name":"stdout","text":["12297\n"]}]},{"cell_type":"code","source":["emb = C[Xtr] # (32, 3, 2)\n","h = torch.tanh(emb.view(-1, 30) @ W1 + b1) # (32, 100)\n","logits = h @ W2 + b2\n","loss = F.cross_entropy(logits, Ytr)"],"metadata":{"id":"o2789qfYfgRB","executionInfo":{"status":"ok","timestamp":1744009745405,"user_tz":-480,"elapsed":588,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}}},"execution_count":53,"outputs":[]},{"cell_type":"code","source":["# Same optimization as last time\n","# max_steps = 200000\n","max_steps = 30000\n","batch_size = 32\n","lossi = []\n","\n","for i in range(max_steps):\n","\n","  # Minibatch construct\n","  ix = torch.randint(0, Xtr.shape[0], (batch_size,), generator=g)\n","  Xb, Yb = Xtr[ix], Ytr[ix] # Batch X,Y\n","\n","  # Forward pass\n","  emb = C[Xb] # Embed characters into vectors\n","  embcat = emb.view(emb.shape[0], -1) # Concatenate the vectors\n","  # Linear layer\n","  hpreact = embcat @ W1 + b1 # Hidden layer pre-activation #([32,200])\n","\n","  # Batch Norm layer\n","  # ----------------------------------------------------------------------------\n","  bnmeani = hpreact.mean(0, keepdim=True)\n","  bnstdi  = hpreact.std(0, keepdim=True)\n","  hpreact = bngain * (hpreact - bnmeani) / bnstdi + bnbias # mini-batch norm\n","\n","  # Running should not be optimized via gradient.\n","  with torch.no_grad():\n","    bnmean_running = 0.999 * bnmean_running + 0.001 * bnmeani\n","    bnstd_running = 0.999 * bnstd_running + 0.001 * bnstdi\n","  # ----------------------------------------------------------------------------\n","  # Non-linearity\n","  h = torch.tanh(hpreact) # Hidden layer\n","  logits = h @ W2 + b2 # Output layer\n","  loss = F.cross_entropy(logits, Yb) # Loss function\n","\n","  # Backward pass\n","  for p in parameters:\n","    p.grad = None\n","  loss.backward()\n","\n","  # Update\n","  lr = 0.1 if i < 100000 else 0.01 # Step learning rate decay\n","  for p in parameters:\n","    p.data += -lr * p.grad\n","\n","  # Track stats\n","  if i % 10000 == 0: # Print\n","    print(f'{i:7d}/{max_steps:7d}: {loss.item():.4f}')\n","  lossi.append(loss.log10().item())\n","  # break"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"9kULaw5ffhYL","executionInfo":{"status":"ok","timestamp":1744009786085,"user_tz":-480,"elapsed":40678,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"678704f0-47ea-4e4f-c42a-8de90d6de4d4"},"execution_count":54,"outputs":[{"output_type":"stream","name":"stdout","text":["      0/  30000: 3.3147\n","  10000/  30000: 2.0977\n","  20000/  30000: 2.3415\n"]}]},{"cell_type":"markdown","source":["# Summary code in PyTorch"],"metadata":{"id":"9hTzAO9UgbOa"}},{"cell_type":"markdown","source":["\n","The classes we create here are the same API as nn.Module in PyTorch"],"metadata":{"id":"aIg54ZWXj8XX"}},{"cell_type":"code","source":["g = torch.Generator().manual_seed(2147483647)"],"metadata":{"id":"TC6M1Ar1l_S2","executionInfo":{"status":"ok","timestamp":1744014133350,"user_tz":-480,"elapsed":12,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}}},"execution_count":8,"outputs":[]},{"cell_type":"code","source":["# torch.nn.Linear(in_features, out_features, bias=True, device=None, dtype=None)\n","class Linear:\n","\n","  def __init__(self, fan_in, fan_out, bias=True):\n","    # self.weight = torch.randn((fan_in, fan_out), generator=g) / fan_in**0.5\n","    self.weight = torch.zeros((fan_in, fan_out))\n","    self.bias = torch.zeros(fan_out) if bias else None\n","\n","  def __call__(self, x):\n","    self.out = x @ self.weight\n","    if self.bias is not None:\n","      self.out += self.bias\n","    return self.out\n","\n","  def parameters(self):\n","    return [self.weight] + ([] if self.bias is None else [self.bias])"],"metadata":{"id":"Vt8t-Pu2l-mq","executionInfo":{"status":"ok","timestamp":1744014275807,"user_tz":-480,"elapsed":15,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}}},"execution_count":24,"outputs":[]},{"cell_type":"code","source":["# torch.nn.BatchNorm1D()\n","# Pytorch BatchNorm1d does not have self.out\n","# It is\n","class BatchNorm1d:\n","\n","  def __init__(self, dim, eps=1e-5, momentum=0.1):\n","    self.eps = eps\n","    self.momentum = momentum\n","    self.training = True\n","    # Parameters (trained with backprop)\n","    self.gamma = torch.ones(dim)\n","    self.beta = torch.zeros(dim)\n","    # Buffers (trained with a running 'momentum update')\n","    self.running_mean = torch.zeros(dim)\n","    self.running_var = torch.ones(dim)\n","\n","  def __call__(self, x):\n","    # Calculate the forward pass\n","    if self.training:\n","      xmean = x.mean(0, keepdim=True) # Batch mean\n","      xvar = x.var(0, keepdim=True) # Batch variance\n","    else:\n","      xmean = self.running_mean\n","      xvar = self.running_var\n","    xhat = (x - xmean) / torch.sqrt(xvar + self.eps) # Normalize to unit variance\n","    self.out = self.gamma * xhat + self.beta\n","    # Update buffers (running)\n","    if self.training:\n","      with torch.no_grad():\n","        self.running_mean = (1 - self.momentum) * self.running_mean + self.momentum * xmean\n","        self.running_var = (1 - self.momentum) * self.running_var + self.momentum * xvar\n","    return self.out\n","\n","  def parameters(self):\n","    return [self.gamma, self.beta]"],"metadata":{"id":"MwBis9z_gx3V","executionInfo":{"status":"ok","timestamp":1744014202852,"user_tz":-480,"elapsed":20,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}}},"execution_count":19,"outputs":[]},{"cell_type":"code","source":["# torch.nn.Tanh\n","class Tanh:\n","\n","  def __call__(self, x):\n","    self.out = torch.tanh(x)\n","    return self.out\n","\n","  def parameters(self):\n","    return []"],"metadata":{"id":"6hW472BvmBpz","executionInfo":{"status":"ok","timestamp":1744014204398,"user_tz":-480,"elapsed":9,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}}},"execution_count":20,"outputs":[]},{"cell_type":"code","source":["n_embd = 10 # Dimensionality of the character embedding vectors\n","n_hidden = 100 # Number of neurons in the hidden layer of the MLP\n","g = torch.Generator().manual_seed(2147483647) # for reproducibility\n","\n","C = torch.randn((vocab_size, n_embd),            generator=g)\n","layers = [\n","  Linear(n_embd * block_size, n_hidden, bias=False), BatchNorm1d(n_hidden), Tanh(),\n","  Linear(           n_hidden, n_hidden, bias=False), BatchNorm1d(n_hidden), Tanh(),\n","  Linear(           n_hidden, n_hidden, bias=False), BatchNorm1d(n_hidden), Tanh(),\n","  Linear(           n_hidden, n_hidden, bias=False), BatchNorm1d(n_hidden), Tanh(),\n","  Linear(           n_hidden, n_hidden, bias=False), BatchNorm1d(n_hidden), Tanh(),\n","  Linear(           n_hidden, vocab_size, bias=False), BatchNorm1d(vocab_size),\n","]\n","# layers = [\n","#   Linear(n_embd * block_size, n_hidden), Tanh(),\n","#   Linear(           n_hidden, n_hidden), Tanh(),\n","#   Linear(           n_hidden, n_hidden), Tanh(),\n","#   Linear(           n_hidden, n_hidden), Tanh(),\n","#   Linear(           n_hidden, n_hidden), Tanh(),\n","#   Linear(           n_hidden, vocab_size),\n","# ]\n","\n","with torch.no_grad():\n","  # Last layer: make less confident\n","  layers[-1].gamma *= 0.1\n","  # layers[-1].weight *= 0.1\n","\n","  # All other layers: apply gain\n","  for layer in layers[:-1]:\n","    if isinstance(layer, Linear):\n","      layer.weight *= 5/3 #1.0\n","\n","parameters = [C] + [p for layer in layers for p in layer.parameters()]\n","print(sum(p.nelement() for p in parameters)) # Total Number of parameters\n","for p in parameters:\n","  p.requires_grad = True"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"lv8dmZ9Ml4s7","executionInfo":{"status":"ok","timestamp":1744014277906,"user_tz":-480,"elapsed":19,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"5031112b-c6fe-42a7-bd2b-94a9132c86b4"},"execution_count":25,"outputs":[{"output_type":"stream","name":"stdout","text":["47024\n"]}]},{"cell_type":"code","source":["# Same optimization as last time\n","# max_steps = 200000\n","max_steps = 30000\n","batch_size = 32\n","lossi = []\n","ud = []\n","\n","for i in range(max_steps):\n","\n","  # Minibatch construct\n","  ix = torch.randint(0, Xtr.shape[0], (batch_size,), generator=g)\n","  Xb, Yb = Xtr[ix], Ytr[ix] # batch X,Y\n","\n","  # Forward pass\n","  emb = C[Xb] # Embed the characters into vectors\n","  x = emb.view(emb.shape[0], -1) # Concatenate the vectors\n","  for layer in layers:\n","    x = layer(x)\n","  loss = F.cross_entropy(x, Yb) # Loss function\n","\n","  # Backward pass\n","  for layer in layers:\n","    layer.out.retain_grad() # AFTER_DEBUG: would take out retain_graph\n","  for p in parameters:\n","    p.grad = None\n","  loss.backward()\n","\n","  # Update\n","  lr = 0.1 if i < 150000 else 0.01 # Step learning rate decay\n","  for p in parameters:\n","    p.data += -lr * p.grad\n","\n","  # Track stats\n","  if i % 10000 == 0: # Print\n","    print(f'{i:7d}/{max_steps:7d}: {loss.item():.4f}')\n","  lossi.append(loss.log10().item())\n","  with torch.no_grad():\n","    ud.append([((lr*p.grad).std() / p.data.std()).log10().item() for p in parameters])\n","\n","  # if i >= 1000:\n","  #   break # For debug\n","\n","print(\"Done.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"-3mzDShSp9i6","executionInfo":{"status":"ok","timestamp":1744014471700,"user_tz":-480,"elapsed":191985,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"7867b7a2-3259-4a07-e441-6bf211951cba","collapsed":true},"execution_count":26,"outputs":[{"output_type":"stream","name":"stdout","text":["      0/  30000: 3.2958\n","  10000/  30000: 2.7882\n","  20000/  30000: 2.7518\n","Done.\n"]}]},{"cell_type":"markdown","source":["## Visualize and Sampling"],"metadata":{"id":"p58pHZWiqlpQ"}},{"cell_type":"code","source":["# Visualize histograms\n","plt.figure(figsize=(20, 4)) # Width and height of plot\n","legends = []\n","for i, layer in enumerate(layers[:-1]): # Note: exclude output layer\n","  if isinstance(layer, Tanh):\n","    t = layer.out\n","    print('layer %d (%10s): mean %+.2f, std %.2f, saturated: %.2f%%' % (i, layer.__class__.__name__, t.mean(), t.std(), (t.abs() > 0.97).float().mean()*100))\n","    hy, hx = torch.histogram(t, density=True)\n","    plt.plot(hx[:-1].detach(), hy.detach())\n","    legends.append(f'layer {i} ({layer.__class__.__name__}')\n","plt.legend(legends);\n","plt.title('activation distribution')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":498},"id":"IngSiyIeqLeJ","executionInfo":{"status":"ok","timestamp":1744009975695,"user_tz":-480,"elapsed":643,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"6737d6ac-6d8d-4014-880a-0545d84524df"},"execution_count":61,"outputs":[{"output_type":"stream","name":"stdout","text":["layer 2 (      Tanh): mean +0.00, std 0.65, saturated: 8.56%\n","layer 5 (      Tanh): mean -0.01, std 0.69, saturated: 9.19%\n","layer 8 (      Tanh): mean -0.01, std 0.70, saturated: 8.72%\n","layer 11 (      Tanh): mean -0.00, std 0.72, saturated: 6.72%\n","layer 14 (      Tanh): mean +0.01, std 0.72, saturated: 5.19%\n"]},{"output_type":"execute_result","data":{"text/plain":["Text(0.5, 1.0, 'activation distribution')"]},"metadata":{},"execution_count":61},{"output_type":"display_data","data":{"text/plain":["<Figure size 2000x400 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Visualize histograms\n","plt.figure(figsize=(20, 4)) # Width and height of plot\n","legends = []\n","for i, layer in enumerate(layers[:-1]): # Note: exclude output layer\n","  if isinstance(layer, Tanh):\n","    t = layer.out.grad\n","    print('layer %d (%10s): mean %+f, std %e' % (i, layer.__class__.__name__, t.mean(), t.std()))\n","    hy, hx = torch.histogram(t, density=True)\n","    plt.plot(hx[:-1].detach(), hy.detach())\n","    legends.append(f'layer {i} ({layer.__class__.__name__}')\n","plt.legend(legends);\n","plt.title('gradient distribution')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":498},"id":"vXm20GCUqQ8u","executionInfo":{"status":"ok","timestamp":1744009975893,"user_tz":-480,"elapsed":197,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"ba9e3773-2641-4ff5-b353-9bc41ca1612d"},"execution_count":62,"outputs":[{"output_type":"stream","name":"stdout","text":["layer 2 (      Tanh): mean +0.000000, std 2.808549e-03\n","layer 5 (      Tanh): mean +0.000000, std 2.636006e-03\n","layer 8 (      Tanh): mean -0.000000, std 2.627763e-03\n","layer 11 (      Tanh): mean +0.000000, std 2.545659e-03\n","layer 14 (      Tanh): mean -0.000000, std 2.644424e-03\n"]},{"output_type":"execute_result","data":{"text/plain":["Text(0.5, 1.0, 'gradient distribution')"]},"metadata":{},"execution_count":62},{"output_type":"display_data","data":{"text/plain":["<Figure size 2000x400 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["---"],"metadata":{"id":"3xWqvraEPo_y"}},{"cell_type":"markdown","source":["_**GRADIENT-DATA RATIO (GDR) - Learning rate indicator**_\n","- What is the scale of the gradient compared to the scale of the actual values/data-data variance.\n","- Step update: learning_rate * gradient\n","- If grad:data ratio is too large, <u>not good, </u>\n","- This might fix itself at longer steps of training."],"metadata":{"id":"B4dW7WYkNuKX"}},{"cell_type":"code","source":["# Visualize histograms\n","plt.figure(figsize=(20, 4)) # Width and height of the plot\n","legends = []\n","for i,p in enumerate(parameters):\n","  t = p.grad\n","  if p.ndim == 2:\n","    print('weight %10s | mean %+f | std %e | grad:data ratio %e' % (tuple(p.shape), t.mean(), t.std(), t.std() / p.std()))\n","    hy, hx = torch.histogram(t, density=True)\n","    plt.plot(hx[:-1].detach(), hy.detach())\n","    legends.append(f'{i} {tuple(p.shape)}')\n","plt.legend(legends)\n","plt.title('weights gradient distribution');"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":516},"id":"egwQLE0KqWRw","executionInfo":{"status":"ok","timestamp":1744009976156,"user_tz":-480,"elapsed":262,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"ab9141ab-df72-4f3c-d36c-ff1b07ed0eca"},"execution_count":63,"outputs":[{"output_type":"stream","name":"stdout","text":["weight   (27, 10) | mean -0.000000 | std 1.223632e-02 | grad:data ratio 1.201335e-02\n","weight  (30, 100) | mean -0.000199 | std 9.228954e-03 | grad:data ratio 3.628882e-02\n","weight (100, 100) | mean +0.000078 | std 5.552600e-03 | grad:data ratio 3.702611e-02\n","weight (100, 100) | mean +0.000038 | std 5.290192e-03 | grad:data ratio 3.617370e-02\n","weight (100, 100) | mean +0.000011 | std 4.967983e-03 | grad:data ratio 3.498950e-02\n","weight (100, 100) | mean -0.000037 | std 4.495821e-03 | grad:data ratio 3.290453e-02\n","weight  (100, 27) | mean -0.000026 | std 7.810462e-03 | grad:data ratio 3.855850e-02\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 2000x400 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["---"],"metadata":{"id":"ZLaZDHoiPmJy"}},{"cell_type":"markdown","source":["_**UPDATE-DATA RATIO (URG)**_\n","- This is an important graph, shows update ratios.\n","- The black line is the desired update value.\n","- The lines should not be too far from the black line.\n","- _**Below line: Training not fast enough**_\n","- _**Above line: Training too fast **_\n","\n","\n","Note:\n","- This final layer (pink) is an outlier because it is artificially shrunk down:\n","```\n","with torch.no_grad():\n","  # Last layer: make less confident\n","  layers[-1].gamma *= 0.1\n","  # layers[-1].weight *= 0.1\n","```\n","- Reminder that change `.gamma` instead of `.weight` because we are using `Batch Norm`."],"metadata":{"id":"FVbB3TGjPXmx"}},{"cell_type":"code","source":["plt.figure(figsize=(20, 4))\n","legends = []\n","for i,p in enumerate(parameters):\n","  if p.ndim == 2:\n","    plt.plot([ud[j][i] for j in range(len(ud))])\n","    legends.append('param %d' % i)\n","plt.plot([0, len(ud)], [-3, -3], 'k') # these ratios should be ~1e-3, indicate on plot\n","plt.legend(legends);"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":368},"id":"dnj1M68VqYdV","executionInfo":{"status":"ok","timestamp":1744009978155,"user_tz":-480,"elapsed":1997,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"2bb32c19-8dfc-4e36-fc32-525cb3186d03"},"execution_count":64,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 2000x400 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["---"],"metadata":{"id":"PuzWtIVPPkEN"}},{"cell_type":"code","source":["@torch.no_grad() # This decorator disables gradient tracking\n","def split_loss(split):\n","  x,y = {\n","    'train': (Xtr, Ytr),\n","    'val': (Xdev, Ydev),\n","    'test': (Xte, Yte),\n","  }[split]\n","  emb = C[x] # (N, block_size, n_embd)\n","  x = emb.view(emb.shape[0], -1) # concat into (N, block_size * n_embd)\n","  for layer in layers:\n","    x = layer(x)\n","  loss = F.cross_entropy(x, y)\n","  print(split, loss.item())\n","\n","# Put layers into eval mode\n","for layer in layers:\n","  layer.training = False\n","split_loss('train')\n","split_loss('val')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"4cC0XDeSqazk","executionInfo":{"status":"ok","timestamp":1744009981208,"user_tz":-480,"elapsed":3054,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"802208b4-c1b4-4dfb-8f7c-36f0c544b639"},"execution_count":65,"outputs":[{"output_type":"stream","name":"stdout","text":["train 2.134287118911743\n","val 2.1641440391540527\n"]}]},{"cell_type":"markdown","source":["### Summary Graph"],"metadata":{"id":"KTSmTw_kGfqb"}},{"cell_type":"markdown","source":["- We are looking at `gradient distribution` such that each layers are roughtly similar in gradient/shape (None is too shrinking or exploding)\n","- Consider blue is `layer 1`, purple is `layer 9`\n","\n","#### _Without Batch Norm_\n","- Nonlinearity\n"," - If gain is small,\n","    - `activation` is shrinking to 0.\n","    - `gradient distribution`, starting close to 0, grows bigger each next layer."],"metadata":{"id":"mwXRXZ_KGgkO"}},{"cell_type":"markdown","source":["![image.png](data:image/png;base64,)"],"metadata":{"id":"l-vJz-HIHhKj"}},{"cell_type":"markdown","source":["![image.png](data:image/png;base64,)"],"metadata":{"id":"v7NMj8MxH4Kq"}},{"cell_type":"markdown","source":["- If gain is too big\n","  - `activation` starts very big, shrinks close to 0.\n","  - `gradient distribution`, starting close to 0, grows bigger each next layer."],"metadata":{"id":"B6KFBvWwH-6b"}},{"cell_type":"markdown","source":["---\n","\n","- Linearity, gain should be 1; this case gain is too large\n","  - `activation` starts big distribution close to 0, shrinks every next layer. Activation distribution expands every next layer.\n","  - `gradient distribution`, starting close to 0, grows bigger each next layer.\n","  Gradient distribution shrinks closer to 0 every layer.\n","- Opposite is true for when gain is too small.\n","\n","_**NOTE: THIS IS TO BE AVOIDED**_\n"],"metadata":{"id":"ujSewelvITht"}},{"cell_type":"markdown","source":["![image.png](data:image/png;base64,)"],"metadata":{"id":"58XjVLb_Je5I"}},{"cell_type":"markdown","source":["Note that before Batch Normalization, it's tedious to set up weights and biases."],"metadata":{"id":"68X7ZOYaKztR"}},{"cell_type":"markdown","source":["#### _With Batch Norm_\n","- Even without fan_in and shift-scale changing, the model still works pretty well. We may need to update `learning_rate` as shown by `URG`.\n","\n","Basically;\n","- Batch Norm allows a more robust shift-scale/gain-bias, whether we need to change fan_in.\n","- We need to worry more about `learning_rate`."],"metadata":{"id":"0VtuETXLRhN5"}},{"cell_type":"markdown","source":["## Sampling"],"metadata":{"id":"uDSbOiZOGez4"}},{"cell_type":"code","source":["# Sample from the model\n","g = torch.Generator().manual_seed(2147483647 + 10)\n","\n","for _ in range(20):\n","\n","    out = []\n","    context = [0] * block_size # Initialize all with ...\n","    while True:\n","      # forward pass the neural net\n","      emb = C[torch.tensor([context])] # (1,block_size,n_embd)\n","      x = emb.view(emb.shape[0], -1) # Concatenate the vectors\n","      for layer in layers:\n","        x = layer(x)\n","      logits = x\n","      probs = F.softmax(logits, dim=1)\n","      # Sample from the distribution\n","      ix = torch.multinomial(probs, num_samples=1, generator=g).item()\n","      # Shift the context window and track the samples\n","      context = context[1:] + [ix]\n","      out.append(ix)\n","      # If we sample the special '.' token, break\n","      if ix == 0:\n","        break\n","\n","    print(''.join(itos[i] for i in out)) # Decode and print the generated word"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"7TEwrByYqfWW","executionInfo":{"status":"ok","timestamp":1744009981306,"user_tz":-480,"elapsed":97,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"beabf56a-b8a2-40e4-eeea-0f9622482fda"},"execution_count":66,"outputs":[{"output_type":"stream","name":"stdout","text":["mon.\n","ammyah.\n","seel.\n","ndheyah.\n","rethantendra.\n","grazeen.\n","seliah.\n","mikoelle.\n","elieananar.\n","kayzion.\n","kamin.\n","shranzi.\n","hiriel.\n","kindreelynn.\n","novana.\n","uba.\n","avde.\n","jamyle.\n","eli.\n","kayshayveyah.\n"]}]},{"cell_type":"markdown","metadata":{"id":"_3jOXnXr9qU4"},"source":["# Summary"]},{"cell_type":"markdown","metadata":{"id":"rnJR9Et89rcv"},"source":["_DEAD NEURONS_\n","- Can be caused during activation function and its backpropagation,\n","  - AFunc that squashes gradients to a number\n","- Can be caused during initialization,\n","  - The W&B could not activate the activation function, squashed.\n","- Can be caused by learning rate too high,\n","  - May get knocked out of activation bounds, get squashed.\n","- Dead neuron cannot learn and only outputs the same output.\n","\n","Note:\n","**Leaky ReLU** - will not suffer this issue that much (The whole Leaky means it leaks or allows small gradients for negative instead of being completely)\n","\n","---\n","_WHY USE NONLINEARITIES_\n","- If you do not use nonlinearity activation functions, you may get a pretty distribution graph, BUT <u>the whole representation of the model is just a linear layer</u> ;  \n","- It will likely fail in learning complex patterns in data, performing poorly on many tasks.\n","- Moreover, <u>back propagation of linear layers do not produce linear results.</u>\n","- Basically it will be a diminishing return, no matter how deep the layer, it can never understand complex task.\n","\n","---\n","_BATCH NORMALIZATION_\n","- First normalization introduced.\n","- It happened to have regularization effect (at hpreact scale and shift), effectively padding out or introducing noise/entropy to the network; reducing the likelihood of overfitting.\n","- It has been hard to remove batch normalization layer from current models because it works so well; with the regularization effect and is effective at controlling activations and distributions of neurons.\n","- BatchNorm, unlike other normalization layers like LayerNorm/GroupNorm etc. has the big advantage that after training, the batchnorm gamma/beta can be \"folded into\" the weights of the preceeding Linear layers, effectively erasing the need to forward it at test time.\n","- We see that the batchnorm is there just for stabilizing the training, and can be thrown out after training is done.\n","\n","Basically;\n","- Batch Norm allows a more robust shift-scale/gain-bias, whether we need to change fan_in.\n","- We need to worry more about `learning_rate`.\n","\n","However, Batch Normalization layer has issue because it is coupling examples during forward pass.\n","\n","<u>Andrej recommended against using Batch Normalization layer.</u> Instead use, group normalization or layer normalization which are more common currently.\n","\n","---\n","_GRAPH OF ACTIVATION AND GRADIENT DISTRIBUTION_\n","- Ensure that the distributions of both graphs shows consistent, roughly similar shape for all layers.\n","- If it is shrinking/expanding each layer, something is wrong!\n","\n","---\n","_IMPORTANT GRAPHS_\n","- _Activation Distribution_\n","- _Weight Distribution_\n","- _GRADIENT-DATA RATIO (GDR) - Learning rate indicator_\n","- _**UPDATE-DATA RATIO**_\n","  - This is an important graph, shows update ratios.\n","  - The black line is the desired update value.\n","  - The lines should not be too far from the black line.\n","  - _**Below line: Training not fast enough**_\n","  - _Above line: Training too fast_\n","  - A well-behaved URG should be steadily decreasing as the number of updates increases.\n","\n","---\n","Note that the performance of this model with Batch Norm is similar to previous model.\n","- This is simply <u>optimized</u>, reduce redundant codes and trainings.\n","- This shows that the model is not bottlenecked by the lack of optimization.\n","- This model may be bottlenecked by context windows and may not be able to learn complex patterns of names."]}],"metadata":{"colab":{"provenance":[],"collapsed_sections":["F2xKQHD2E6yg","NJ7KRChOfr02"],"authorship_tag":"ABX9TyPgoqrWsKKFhUwJTS71DKEH"},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":0}