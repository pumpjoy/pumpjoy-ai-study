text = context[1:] + [ix] # crop and append\n","\n","  X = torch.tensor(X)\n","  Y = torch.tensor(Y)\n","  print(X.shape, Y.shape)\n","  return X, Y\n","\n","import random\n","random.seed(42)\n","random.shuffle(words)\n","n1 = int(0.8*len(words))\n","n2 = int(0.9*len(words))\n","\n","Xtr,  Ytr  = build_dataset(words[:n1])     # 80%\n","Xdev, Ydev = build_dataset(words[n1:n2])   # 10%\n","Xte,  Yte  = build_dataset(words[n2:])     # 10%"],"metadata":{"id":"TMP_hfyWeJtA","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1747101982966,"user_tz":-480,"elapsed":2992,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"0e8d7a9b-3a59-4a90-efc5-8441086e688e"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["torch.Size([182625, 3]) torch.Size([182625])\n","torch.Size([22655, 3]) torch.Size([22655])\n","torch.Size([22866, 3]) torch.Size([22866])\n"]}]},{"cell_type":"markdown","source":["# Code Exercise Begin"],"metadata":{"id":"hz4wm5aveQbv"}},{"cell_type":"markdown","source":["Utility function: Compare manual gradient to PyTorch gradients"],"metadata":{"id":"7AenwFRZnQ4c"}},{"cell_type":"code","source":["# Explaining cmp function\n","\"\"\"\n","ex = torch.all\n","  - Check that value is `dt` is exactly equal to `t.grad`\n","  - ie. check that manually calculated are equal to loss.backward()'s\n","  - .item() gets to Boolean value, not the tensor\n","\n","app = torch.allclose\n","  - If they are not exactly equal, how close is it\n","\n","maxdiff\n","  - Get the value that has the highest difference, and its absolute difference\n","\"\"\""],"metadata":{"id":"04tpZjHJdiHH","colab":{"base_uri":"https://localhost:8080/","height":53},"executionInfo":{"status":"ok","timestamp":1747101983000,"user_tz":-480,"elapsed":31,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"6d998e7a-b10e-4040-c171-6cc834d6a3ba"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["\"\\nex = torch.all\\n  - Check that value is `dt` is exactly equal to `t.grad`\\n  - ie. check that manually calculated are equal to loss.backward()'s\\n  - .item() gets to Boolean value, not the tensor\\n\\napp = torch.allclose\\n  - If they are not exactly equal, how close is it\\n\\nmaxdiff\\n  - Get the value that has the highest difference, and its absolute difference\\n\""],"application/vnd.google.colaboratory.intrinsic+json":{"type":"string"}},"metadata":{},"execution_count":6}]},{"cell_type":"code","source":["def cmp(s, dt, t):\n","  ex = torch.all(dt == t.grad).item()\n","  app = torch.allclose(dt, t.grad)\n","  maxdiff = (dt - t.grad).abs().max().item()\n","  print(f'{s:15s} | exact: {str(ex):5s} | approximate: {str(app):5s} | maxdiff: {maxdiff}')"],"metadata":{"id":"66aKXndtnUaw"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Actual code"],"metadata":{"id":"zAELK7sRnWCk"}},{"cell_type":"code","execution_count":null,"metadata":{"id":"kDGDonECda-D","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1747101983048,"user_tz":-480,"elapsed":44,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"c45435d5-dfb0-4205-b266-369a28c00571"},"outputs":[{"output_type":"stream","name":"stdout","text":["4137\n"]}],"source":["n_embd = 10 # the dimensionality of the character embedding vectors\n","n_hidden = 64 # the number of neurons in the hidden layer of the MLP\n","\n","g = torch.Generator().manual_seed(2147483647) # for reproducibility\n","C  = torch.randn((vocab_size, n_embd),            generator=g)\n","# Layer 1\n","W1 = torch.randn((n_embd * block_size, n_hidden), generator=g) * (5/3)/((n_embd * block_size)**0.5)\n","b1 = torch.randn(n_hidden,                        generator=g) * 0.1 # using b1 just for fun, it's useless because of BN\n","# Layer 2\n","W2 = torch.randn((n_hidden, vocab_size),          generator=g) * 0.1\n","b2 = torch.randn(vocab_size,                      generator=g) * 0.1\n","# BatchNorm parameters\n","bngain = torch.randn((1, n_hidden))*0.1 + 1.0\n","bnbias = torch.randn((1, n_hidden))*0.1\n","\n","# Note: I am initializating many of these parameters in non-standard ways\n","# because sometimes initializating with e.g. all zeros could mask an incorrect\n","# implementation of the backward pass.\n","\n","parameters = [C, W1, b1, W2, b2, bngain, bnbias]\n","print(sum(p.nelement() for p in parameters)) # number of parameters in total\n","for p in parameters:\n","  p.requires_grad = True"]},{"cell_type":"code","source":["batch_size = 32\n","n = batch_size # a shorter variable also, for convenience\n","# construct a minibatch\n","ix = torch.randint(0, Xtr.shape[0], (batch_size,), generator=g)\n","Xb, Yb = Xtr[ix], Ytr[ix] # batch X,Y"],"metadata":{"id":"yDbGqi4anY0K"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Forward pass, \"chunkated\" into smaller steps that are possible to backward one at a time\n","\n","emb = C[Xb] # embed the characters into vectors\n","embcat = emb.view(emb.shape[0], -1) # concatenate the vectors\n","# Linear layer 1\n","hprebn = embcat @ W1 + b1 # hidden layer pre-activation\n","# BatchNorm layer\n","bnmeani = 1/n*hprebn.sum(0, keepdim=True)\n","bndiff = hprebn - bnmeani\n","bndiff2 = bndiff**2\n","bnvar = 1/(n-1)*(bndiff2).sum(0, keepdim=True) # note: Bessel's correction (dividing by n-1, not n)\n","bnvar_inv = (bnvar + 1e-5)**-0.5\n","bnraw = bndiff * bnvar_inv\n","hpreact = bngain * bnraw + bnbias\n","# Non-linearity\n","h = torch.tanh(hpreact) # hidden layer\n","# Linear layer 2\n","logits = h @ W2 + b2 # output layer\n","# cross entropy loss (same as F.cross_entropy(logits, Yb))\n","logit_maxes = logits.max(1, keepdim=True).values\n","norm_logits = logits - logit_maxes # subtract max for numerical stability\n","counts = norm_logits.exp()\n","counts_sum = counts.sum(1, keepdims=True)\n","counts_sum_inv = counts_sum**-1 # If I use (1.0 / counts_sum) instead then I can't get backprop to be bit exact...\n","probs = counts * counts_sum_inv\n","logprobs = probs.log()\n","loss = -logprobs[range(n), Yb].mean()\n","\n","# PyTorch backward pass\n","for p in parameters:\n","  p.grad = None\n","for t in [logprobs, probs, counts, counts_sum, counts_sum_inv, # afaik there is no cleaner way\n","          norm_logits, logit_maxes, logits, h, hpreact, bnraw,\n","         bnvar_inv, bnvar, bndiff2, bndiff, hprebn, bnmeani,\n","         embcat, emb]:\n","  t.retain_grad()\n","loss.backward()\n","loss"],"metadata":{"id":"Jy-ISDRYnarr","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1747101983114,"user_tz":-480,"elapsed":66,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"aec444c3-32a6-44db-e45c-7d41768bb2dc"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["tensor(3.3150, grad_fn=<NegBackward0>)"]},"metadata":{},"execution_count":10}]},{"cell_type":"markdown","source":["Note: why - logit_maxes"],"metadata":{"id":"b3u3lo7JMo_2"}},{"cell_type":"code","source":["# Logits will go through an exponent:\n","# -----------------\n","#   counts = norm_logits.exp()\n","# In order to avoid exponent to a big value,\n","#   norm_logits = logits - logit_maxes\n","# So that the maximum value logit will be equal to 0.\n","# Moreover, gradient of logit_maxes should be 0 or close to\n","# as it will not affect probs and loss.\n","# -----------------"],"metadata":{"id":"TkUn-cpBMsY3"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["## Exercise 1: Backprop through everything manually"],"metadata":{"id":"aAT_WrJ8nqSO"}},{"cell_type":"markdown","source":["Reminder: Check shape first!"],"metadata":{"id":"o29hcy-sSHcg"}},{"cell_type":"markdown","source":["1. Forward: When there is .sum()\n"," - Backward: becomes a replication or broadcast along the same dimension"],"metadata":{"id":"XfTkPcs8YU2X"}},{"cell_type":"code","source":["bnvar = 1/(n-1)*(bndiff2).sum(0, keepdim=True)\n","# bnvar.shape, bndiff2.shape\n","# (torch.Size([1, 64]), torch.Size([32, 64]))"],"metadata":{"id":"geTfGiaFY1rg"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["\n","2. Forward: When there is replication or broadcast\n"," - Indicates a variable reuse\n"," - Backward: That turns into a sum over the same dimension"],"metadata":{"id":"srQRY6z9Y1W3"}},{"cell_type":"code","source":["# Yb = array of the correct indexes/words ; index 0=8th column, index_1=14th column\n","print(Yb)\n","print(Yb.shape)\n","\n","# Example, Reminder that\n","# loss = -(a+b+c)/3\n","# loss = -((a+b+c).mean())\n","# loss = -1/3a + -1/3b + -1/3c\n","# dloss/da = -1/3\n","# -----------------\n","# loss = -logprobs[range(n), Yb].mean()\n","# loss = -((Yb[0]+Yb[1]+Yb[n])/n)\n","# dloss/da = -1/n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"3y0u1jjVSYad","executionInfo":{"status":"ok","timestamp":1747101983195,"user_tz":-480,"elapsed":48,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"e1f3f103-e9e6-4202-ab77-b13ab48bd70a"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["tensor([ 8, 14, 15, 22,  0, 19,  9, 14,  5,  1, 20,  3,  8, 14, 12,  0, 11,  0,\n","        26,  9, 25,  0,  1,  1,  7, 18,  9,  3,  5,  9,  0, 18])\n","torch.Size([32])\n"]}]},{"cell_type":"code","source":["# Exercise 1: backprop through the whole thing manually,\n","# backpropagating through exactly all of the variables\n","# as they are defined in the forward pass above, one by one\n","\n","# -----------------\n","# YOUR CODE HERE :)\n","# -----------------\n","\n","# Derivative of logprobs from loss\n","# loss = -logprobs[range(n), Yb].mean()\n","# -----------------\n","# Andrej's\n","# dlogprobs = torch.zeros_like(logprobs)\n","# dlogprobs[range(n), Yb] = -1.0/n\n","\n","# Get from Yb, populate by indexes\n","# -----------------\n","dlogprobs = torch.zeros_like(logprobs)\n","for i, y in enumerate(Yb):\n","  dlogprobs[i, y] = - 1.0/n\n","\n","# Derivative of probs\n","# logprobs = probs.log()\n","# !! d(logx)/dx = 1/x ; x = probs\n","# !! d(logprobs)/dprobs = (1/dprobs) * dlogprobs <- Chain\n","# dprobs = dlogprobs/probs # this works\n","dprobs = (1.0/probs)*dlogprobs\n","\n","# Derivative of counts_sum_inv\n","# !! probs = counts* counts_sum_inv\n","# -----------------\n","# This is similar to: with extra codes to prevent exponent too large number\n","# logits = xenc @ W # log-counts\n","# counts = logits.exp() # equivalent N\n","# probs = counts / counts.sum(1, keepdims=True)\n","# -----------------\n","# Reasoning:\n","# print(counts.shape) # torch.Size([32, 27])\n","# print(counts_sum_inv.shape) # torch.Size([32, 1])\n","# - Notice that they have different shapes\n","# !! c = a * b\n","# !! a[3x3] * b[3x1]\n","# !! a11xb1 a12xb1 a13xb1\n","# !! a21xb2 a22xb2 a23xb2\n","# !! a31xb3 a32xb3 a33xb3\n","# !! c[3x3]\n","# -----------------\n","# From `probs = counts * counts_sum_inv`\n","# We can see the local derivative of `counts_sum_inv` is simply `counts`\n","# We want to find 6counts_sum_inv / 6counts\n","# !! Consider a = counts\n","# !! Consider b = dprobs (Because of chain rule)\n","# !! 6counts_sum_inv/6counts = 6counts_sum_inv/6counts_sum x 6counts_sum/6counts\n","# Check below for details\n","# Multiply counts and dprobs, sum its rows together, and keep the dimension\n","dcounts_sum_inv = (counts * dprobs).sum(1, keepdims=True)\n","\n","# Derivative of counts_sum\n","# !! counts_sum_inv = counts_sum**1\n","# d(1/x) = -1/x**2\n","# dcounts_sum = (-1/counts_sum**2) * [Chain-rule] dcounts_sum_inv\n","dcounts_sum = (-counts_sum**-2) * dcounts_sum_inv\n","\n","# -----------------\n","# Started to get it after here!!\n","# -----------------\n","\n","# Derivative of counts - There are 2 branches\n","# !! counts_sum = counts.sum(1, keepdims=True)\n","# !! probs = counts *\n","# Derivitive of counts_sum_inv = (counts_sum_inv * dprobs)\n","# Derivative of counts_sum\n","dcounts = (counts_sum_inv * dprobs) + dcounts_sum\n","\n","# -----------------\n","# Andrej's\n","dcounts_sum_inv = (counts * dprobs).sum(1, keepdims=True)\n","# counts' 1st branch\n","dcounts = counts_sum_inv * dprobs\n","\n","dcounts_sum = (-counts_sum**-2) * dcounts_sum_inv\n","# counts' 2nd branch\n","dcounts += torch.ones_like(counts) * dcounts_sum\n","# -----------------\n","\n","# Derivative of norm_logits\n","# counts = norm_logits.exp()\n","# dnorm_logits = norm_logits.exp() * dcounts\n","dnorm_logits = counts * dcounts\n","\n","# NOTICE!!!----------------------------------\n","# Derivative of logit_maxes\n","# norm_logits = logits - logit_maxes # subtract max for numerical stability\n","# !! norm_logits.shape  # torch.Size([32, 27])\n","# !! logits.shape       # torch.Size([32, 27])\n","# !! dnorm_logits.shape # torch.Size([32, 1])\n","# Broadcasting is happening here\n","\"\"\"\n","c11 c12 c13 = a11 a12 a13   b1\n","c21 c22 c23 = a21 a22 a23 - b2\n","c31 c32 c33 = a31 a32 a33   b3\n","\n","c32 = a32 - b3\n","- Local derivatative of bN is -1.0\n","\"\"\"\n","dlogits = dnorm_logits.clone() # logits - Branch 1\n","dlogit_maxes = (-dnorm_logits).sum(1, keepdims=True)\n","\n","\n","# Derivative of logits\n","# norm_logits = logits - logit_maxes # Branch 1\n","# logit_maxes = logits.max(1, keepdim=True).values # Branch 2\n","# !!  F.one_hot(logits.max(1).indices, num_classes=logits.shape[1])\n","# - `logits.max(1).indixes` - Find indices of max values along dimension 1\n","#  - logits has (batch_size, num_clsses);\n","#  - max(1) return 2 tensors, max_values and indices of these max_values\n","# - `num_classes=logits.shape[1]` - Gets columns; alphabets and `.`\n","# - F.one_hot(...) - Convert indices into one-hot encoded tensor.\n","#  - For example, if an index is 3, resulting one-hot vector = [0, 0, 0, 1, 0].\n","dlogits += F.one_hot(logits.max(1).indices, num_classes=logits.shape[1]) * dlogit_maxes\n","\n","\n","# Derivative of h, W2 and b2\n","# logits = h @ W2 + b2 # output layer\n","### dlogits.shape # torch.Size([32, 27])\n","### h.shape       # torch.Size([32, 64])\n","### W2.shape      # torch.Size([64, 27])\n","### b2.shape      # torch.Size([27])\n","\"\"\"\n","l11 l12 = h11 h12 * W11 W12 + b1 b2\n","l21 l22   h21 h22   W21 W22   b1 b2\n","bias becomes a row and is being broadcasted vertically\n","-------------------------------------\n","l11 = h11W11 + h12W21 + b1\n","l12 = h11W12 + h12W22 + b2\n","l21 = h21W11 + h22W21 + b1\n","l22 = h21W12 + h22W22 + b2\n","-------------------------------------\n","1. for h11\n","dL/dh11 = affects l11 and l12\n","locl_der `dl11/dh11`  and `dl12/dh11`\n","dL/dh11 = (dL/dl11)*(W11) + (dL/dl12)*(W12)\n","--------------\n","2. for h12\n","dL/dh12 = (dL/dl11)*(W21) + (dL/dl12)*(W22)\n","--------------\n","3. for h21\n","dL/dh21 = (dL/dl21)*(W11) + (dL/dl22)*(W12)\n","--------------\n","4. for h22\n","dL/dh22 = (dL/dl2)*(W21) + (dL/dl22)*(W22)\n","-------------------------------------\n","dL/dh = | dL/dh11  dL/dh12 |\n","        | dL/dh21  dL/dh22 |\n","      = | dL/dl11  dL/dl12 | * | W11  W21 |\n","        | dL/dl21  dL/dl22 |   | W12  W21 |\n","      = | dL/dl11  dL/dl12 | * | W11  W21 |\n","        | dL/dl21  dL/dl22 |   | W12  W21 |\n","Notice Wxx is transposed\n","dL/dh = dL/dl @ W2^T\n","--------------\n","dL/dW2 = h^T @ dL/dl\n","--------------\n","dL/db2 = dL/dl . sum(0) # (sum the columns)\n","\"\"\"\n","dh = dlogits @ W2.T\n","dW2 = h.T @ dlogits\n","db2 = dlogits.sum(0)\n","# -----------------\n","\n","\n","# Derivative of hpreact\n","# # Non-linearity\n","# h = torch.tanh(hpreact) # hidden layer\n","# !! dL/hpreach = dL/dh * dh/dhpreact\n","# !! Derivative of y = tanh(x), dy/dx = 1-y^2\n","# !! h = tanh(hpreact), dh/dhpreact = 1-h^2\n","dhpreact = (1.0 - h**2) * dh\n","\n","\n","# Derivative of bngain, bnbias and bnraw\n","# hpreact = bngain * bnraw + bnbias\n","# !! Note that * is different from @\n","# !! @ is dot product\n","# !! * is element-wise multiplication\n","### hpreact.shape # torch.Size([32, 64])\n","### bngain.shape  # torch.Size([1, 64])\n","### bnraw.shape   # torch.Size([32, 64])\n","### bnbias.shape  # torch.Size([1, 64])\n","dbngain = (bnraw * dhpreact).sum(0, keepdims=True)\n","dbnraw = bngain * dhpreact\n","dbnbias = dhpreact.sum(0, keepdim=True)\n","\n","# ----------------------------------\n","# BatchNorm layer\n","# bnmeani = 1/n*hprebn.sum(0, keepdim=True)\n","# bndiff = hprebn - bnmeani\n","# bndiff2 = bndiff**2\n","# bnvar = 1/(n-1)*(bndiff2).sum(0, keepdim=True) # note: Bessel's correction (dividing by n-1, not n)\n","# bnvar_inv = (bnvar + 1e-5)**-0.5\n","# bnraw = bndiff * bnvar_inv # [32, 64] * [1, 64] (broadcast sum(0))\n","### bnraw.shape       # torch.Size([32, 64])\n","### bndiff.shape      # torch.Size([32, 64])\n","### bnvar_inv.shape   # torch.Size([1, 64]) # dbnvar_inv->torch.Size([1, 64])\n","dbndiff = bnvar_inv * dbnraw # dbndiff Branch 1\n","dbnvar_inv = (bndiff * dbnraw).sum(0, keepdims=True) # BUG: DON'T KNOW WHAT ERROR\n","\n","dbnvar = (-0.5*(bnvar+1e-5)**-1.5) * dbnvar_inv\n","dbndiff2 = (1.0/(n-1))*torch.ones_like(bndiff2) * dbnvar\n","\n","# dbndiff Branch 2, need to +=\n","dbndiff += (2*bndiff) * dbndiff2\n","\n","# ----------------- hprebn and bnmeani\n","# Branch 1\n","# bndiff = hprebn - bnmeani\n","### bndiff.shape,           hprebn.shape,         bnmeani.shape\n","### (torch.Size([32, 64]),  torch.Size([32, 64]), torch.Size([1, 64]))\n","dhprebn = dbndiff.clone() # dhprebn/dbndiff\n","### bndiff = (~~hprebn~~) - (this->bnmeani)\n","dbnmeani = (-torch.ones_like(bndiff) * dbndiff).sum(0)\n","dbnmeani = (-dbndiff).sum(0) # Same thing with above\n","\n","\n","# Branch 2\n","# bnmeani = 1/n*hprebn.sum(0, keepdim=True)\n","# !! .sum() in forward pass becomes broadcast in backward\n","# !! 1. dbnmeani's gradient will be scaled by (1/n)\n","# !! 2. then, will be flow across all the columns\n","#       and deposit itself into dhprebn (* torch.ones_like(hprebn))\n","dhprebn += 1.0/n * torch.ones_like(hprebn) * dbnmeani\n","\n","# -----------------\n","# hprebn = embcat @ W1 + b1 # hidden layer pre-activation\n","### hprebn.shape,         embcat.shape,         W1.shape,             b1.shape\n","###(torch.Size([32, 64]), torch.Size([32, 30]), torch.Size([30, 64]), torch.Size([64])) -\n","# Linear layers back prop, only need to match shapes.\n","\n","dembcat = dhprebn @ W1.T\n","dW1 = embcat.T @ dhprebn\n","db1 = dhprebn.sum(0) # eliminat [32] from [32, 64]. Don't keep dims because it is originally ([64])\n","\n","# -----------------\n","# embcat = emb.view(emb.shape[0], -1) # concatenate the vectors\n","### embcat.shape,           emb.shape\n","### (torch.Size([32, 30]),  torch.Size([32, 3, 10]))\n","# embcat is just concatenated 3 by 10.\n","# We just need to undo that.\n","demb = dembcat.view(emb.shape)\n","\n","# -----------------\n","# emb = C[Xb] # embed the characters into vectors\n","### emb.shape,                C.shape,              Xb.shape\n","### (torch.Size([32, 3, 10]), torch.Size([27, 10]), torch.Size([32, 3]))\n","# We just need to route the gradients backwards through the emb assignment\n","# Find which row of C that every one of those embeddings [3, 10] come from\n","# then deposit them into dC.\n","dC = torch.zeros_like(C)\n","for k in range(Xb.shape[0]):\n","  for j in range(Xb.shape[1]):\n","    ix = Xb[k,j]\n","    dC[ix] += demb[k,j]\n","\n","# ----------------------------------\n","\n","cmp('logprobs', dlogprobs, logprobs)\n","cmp('probs', dprobs, probs)\n","cmp('counts_sum_inv', dcounts_sum_inv, counts_sum_inv)\n","cmp('counts_sum', dcounts_sum, counts_sum)\n","cmp('counts', dcounts, counts)\n","cmp('norm_logits', dnorm_logits, norm_logits)\n","cmp('logit_maxes', dlogit_maxes, logit_maxes)\n","cmp('logits', dlogits, logits)\n","cmp('h', dh, h)\n","cmp('W2', dW2, W2)\n","cmp('b2', db2, b2)\n","cmp('hpreact', dhpreact, hpreact)\n","cmp('bngain', dbngain, bngain)\n","cmp('bnbias', dbnbias, bnbias)\n","cmp('bnraw', dbnraw, bnraw)\n","cmp('bnvar_inv', dbnvar_inv, bnvar_inv)\n","# cmp('bnvar', dbnvar, bnvar)\n","cmp('bndiff2', dbndiff2, bndiff2)\n","cmp('bndiff', dbndiff, bndiff)\n","cmp('bnmeani', dbnmeani, bnmeani)\n","cmp('hprebn', dhprebn, hprebn)\n","cmp('embcat', dembcat, embcat)\n","cmp('W1', dW1, W1)\n","cmp('b1', db1, b1)\n","cmp('emb', demb, emb)\n","cmp('C', dC, C)"],"metadata":{"id":"BDeQc2RfnmQK","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1747101983262,"user_tz":-480,"elapsed":61,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"c4734dc3-e403-4bc0-d9bb-5f7d10284272"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["logprobs        | exact: True  | approximate: True  | maxdiff: 0.0\n","probs           | exact: True  | approximate: True  | maxdiff: 0.0\n","counts_sum_inv  | exact: True  | approximate: True  | maxdiff: 0.0\n","counts_sum      | exact: True  | approximate: True  | maxdiff: 0.0\n","counts          | exact: True  | approximate: True  | maxdiff: 0.0\n","norm_logits     | exact: True  | approximate: True  | maxdiff: 0.0\n","logit_maxes     | exact: True  | approximate: True  | maxdiff: 0.0\n","logits          | exact: True  | approximate: True  | maxdiff: 0.0\n","h               | exact: True  | approximate: True  | maxdiff: 0.0\n","W2              | exact: True  | approximate: True  | maxdiff: 0.0\n","b2              | exact: True  | approximate: True  | maxdiff: 0.0\n","hpreact         | exact: False | approximate: True  | maxdiff: 9.313225746154785e-10\n","bngain          | exact: False | approximate: True  | maxdiff: 1.862645149230957e-09\n","bnbias          | exact: False | approximate: True  | maxdiff: 3.725290298461914e-09\n","bnraw           | exact: False | approximate: True  | maxdiff: 9.313225746154785e-10\n","bnvar_inv       | exact: False | approximate: True  | maxdiff: 7.4