title>\n<path fill=\"none\" stroke=\"black\" d=\"M284.26,-45.5C292.05,-45.5 301.1,-45.5 310.75,-45.5\"/>\n<polygon fill=\"black\" stroke=\"black\" points=\"310.99,-49 320.99,-45.5 310.99,-42 310.99,-49\"/>\n</g>\n</g>\n</svg>\n","text/plain":["<graphviz.graphs.Digraph at 0x7ab5b01afb10>"]},"metadata":{},"execution_count":15}]},{"cell_type":"markdown","source":["### Ver 4 Summary\n","- The above are all manual work of back propagation\n","\n","- Essentially it is derivative of output with respect to local variable which relates to the derivative of previous child. Recursively.\n","\n","The following shows 1 step of optimizisation. L should increase positively. (Hopefully converging to a global minima/maxima)"],"metadata":{"id":"nHnIF9dT73ss"}},{"cell_type":"code","source":["step_size = 0.01\n","a.data += step_size * a.grad\n","b.data += step_size * b.grad\n","c.data += step_size * c.grad\n","f.data += step_size * f.grad\n","\n","e = a * b\n","d = e + c\n","L = d * f\n","print(L.data)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"jQqoecMk-I53","executionInfo":{"status":"ok","timestamp":1742440420668,"user_tz":-480,"elapsed":9,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"652bdea3-c269-480a-882c-7cc55d02b996"},"execution_count":16,"outputs":[{"output_type":"stream","name":"stdout","text":["-7.286496\n"]}]},{"cell_type":"markdown","source":["## Ver 5 - Optimize via 1 neuron"],"metadata":{"id":"5XChHJMB_FrN"}},{"cell_type":"markdown","source":["In the simplest case, this neuron is a perceptron,"],"metadata":{"id":"cOx4CSrg_RMx"}},{"cell_type":"markdown","source":["![neuron_model.jpeg](data:image/jpeg;base64,)"],"metadata":{"id":"kpXi-nin_6A2"}},{"cell_type":"markdown","source":["Image from Stanford University's CS231"],"metadata":{"id":"6UkgXzUV_7PY"}},{"cell_type":"markdown","source":["We have 2 inputs (x1w1 and x2w2), 1 cell body (n), activation function (f).\n","\n","Note: tanh function is to be implemented additionally in Value class because we need exponential (Only add and mul so far)."],"metadata":{"id":"_lhQ4COIEWBx"}},{"cell_type":"code","source":["class Value:\n","  def __init__(self, data, _children=(), _op='', label=''):\n","    \"\"\"\n","    *args\n","      data: data variable\n","      _children: list of previous/parent Value\n","      _op: what operation created this/child Value\n","    \"\"\"\n","    self.data = data\n","    self._prev = set(_children)\n","    self._op = _op\n","    self.grad = 0.0\n","    self.label = label\n","\n","  # Print out a nice looking expression whenever called to print\n","  def __repr__(self):\n","    return f\"Value(data={self.data})\"\n","\n","  def __add__(self, other):\n","    out = Value (self.data + other.data, (self, other), '+')\n","    return out\n","\n","  def __mul__(self,other):\n","    out = Value (self.data * other.data, (self, other), '*')\n","    return out\n","\n","  def tanh(self):\n","    x = self.data\n","    t = (math.exp(2*x)-1)/(math.exp(2*x)+1)\n","    out = Value(t, (self,), 'tanh')\n","    return out"],"metadata":{"id":"Yz7kp20sFENp","executionInfo":{"status":"ok","timestamp":1742440420669,"user_tz":-480,"elapsed":3,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}}},"execution_count":17,"outputs":[]},{"cell_type":"code","source":["# inputs x1, x2\n","x1 = Value(2.0, label='x1')\n","x2 = Value(0.0, label='x2')\n","\n","# weights\n","w1 = Value(-3.0, label='w1')\n","w2 = Value( 1.0, label='w2')\n","\n","# bias of the neuron\n","b = Value(6.88, label='b')\n","\n","# x1w1 + x2w2 + b\n","x1w1 = x1*w1; x1w1.label='x1*w1'\n","x2w2 = x2*w2; x2w2.label='x2*w2'\n","x1w1x2w2 = x1w1 + x2w2; x1w1x2w2.label='x1*w1 + x2*w2'\n","n = x1w1x2w2 + b; n.label='n'\n","\n","# with activation function\n","o = n.tanh(); o.label = 'o'\n","draw_dot(o)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":321},"id":"CS_rclLF_5sF","executionInfo":{"status":"ok","timestamp":1742440420724,"user_tz":-480,"elapsed":58,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"ef8e5ddd-00a9-4537-fb63-429edc117b89"},"execution_count":18,"outputs":[{"output_type":"execute_result","data":{"image/svg+xml":"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"no\"?>\n<!DOCTYPE svg PUBLIC \"-//W3C//DTD SVG 1.1//EN\"\n \"http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd\">\n<!-- Generated by graphviz version 2.43.0 (0)\n -->\n<!-- Title: %3 Pages: 1 -->\n<svg width=\"1575pt\" height=\"210pt\"\n viewBox=\"0.00 0.00 1575.00 210.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<g id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(4 206)\">\n<title>%3</title>\n<polygon fill=\"white\" stroke=\"transparent\" points=\"-4,4 -4,-206 1571,-206 1571,4 -4,4\"/>\n<!-- 134920762360848 -->\n<g id=\"node1\" class=\"node\">\n<title>134920762360848</title>\n<polygon fill=\"none\" stroke=\"black\" points=\"0,-165.5 0,-201.5 200,-201.5 200,-165.5 0,-165.5\"/>\n<text text-anchor=\"middle\" x=\"16.5\" y=\"-179.8\" font-family=\"Times,serif\" font-size=\"14.00\">w1</text>\n<polyline fill=\"none\" stroke=\"black\" points=\"33,-165.5 33,-201.5 \"/>\n<text text-anchor=\"middle\" x=\"75.5\" y=\"-179.8\" font-family=\"Times,serif\" font-size=\"14.00\">data &#45;3.0000</text>\n<polyline fill=\"none\" stroke=\"black\" points=\"118,-165.5 118,-201.5 \"/>\n<text text-anchor=\"middle\" x=\"159\" y=\"-179.8\" font-family=\"Times,serif\" font-size=\"14.00\">grad 0.0000</text>\n</g>\n<!-- 134920761589648* -->\n<g id=\"node13\" class=\"node\">\n<title>134920761589648*</title>\n<ellipse fill=\"none\" stroke=\"black\" cx=\"263\" cy=\"-128.5\" rx=\"27\" ry=\"18\"/>\n<text text-anchor=\"middle\" x=\"263\" y=\"-124.8\" font-family=\"Times,serif\" font-size=\"14.00\">*</text>\n</g>\n<!-- 134920762360848&#45;&gt;134920761589648* -->\n<g id=\"edge14\" class=\"edge\">\n<title>134920762360848&#45;&gt;134920761589648*</title>\n<path fill=\"non