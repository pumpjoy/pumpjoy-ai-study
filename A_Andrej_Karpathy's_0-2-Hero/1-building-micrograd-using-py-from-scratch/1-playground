,"name":"stdout","text":["d1 4.0\n","d2 3.997\n","slope -3.0000000000001137\n"]}]},{"cell_type":"markdown","source":["# Micrograd"],"metadata":{"id":"-MVryI8ZdRsu"}},{"cell_type":"markdown","source":["Versions are just expanded from previous for easier understanding."],"metadata":{"id":"5gtJCG_4eikE"}},{"cell_type":"markdown","source":["## Ver 1 - Simple"],"metadata":{"id":"O1QpIuFfeexm"}},{"cell_type":"code","source":["class Value:\n","  def __init__(self, data):\n","    self.data = data\n","\n","  # Print out a nice looking expression whenever called to print\n","  def __repr__(self):\n","    return f\"Value(data={self.data})\"\n","\n","  def __add__(self, other):\n","    out = Value (self.data + other.data)\n","    return out\n","\n","  def __mul__(self,other):\n","    out = Value (self.data * other.data)\n","    return out\n","\n","\n","a = Value(2.0)\n","b = Value(-3.0)\n","c = Value(10.0)\n","\n","a*b + c"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"WFayrOU6dTjE","executionInfo":{"status":"ok","timestamp":1742440420327,"user_tz":-480,"elapsed":19,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"b1df1062-8f60-4d38-9583-4c6f29365fe4"},"execution_count":6,"outputs":[{"output_type":"execute_result","data":{"text/plain":["Value(data=4.0)"]},"metadata":{},"execution_count":6}]},{"cell_type":"markdown","source":["## Ver 2 - _children and _op"],"metadata":{"id":"Ruxub2iseg3C"}},{"cell_type":"code","source":["class Value:\n","  def __init__(self, data, _children=(), _op=''):\n","    \"\"\"\n","    *args\n","      data: data variable\n","      _children: list of previous/parent Value\n","      _op: what operation created this/child Value\n","    \"\"\"\n","    self.data = data\n","    self._prev = set(_children)\n","    self._op = _op\n","\n","  # Print out a nice looking expression whenever called to print\n","  def __repr__(self):\n","    return f\"Value(data={self.data})\"\n","\n","  def __add__(self, other):\n","    out = Value (self.data + other.data, (self, other), '+')\n","    return out\n","\n","  def __mul__(self,other):\n","    out = Value (self.data * other.data, (self, other), '*')\n","    return out\n","\n","\n","a = Value(2.0)\n","b = Value(-3.0)\n","c = Value(10.0)\n","\n","d = a*b + c\n","\n","print(f'_prev: {d._prev}') # Parent Value: (a*b, c)\n","print(f'_op: {d._op}') #"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Vq_TCxdUdjii","executionInfo":{"status":"ok","timestamp":1742440420334,"user_tz":-480,"elapsed":13,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"b4dafc34-70a0-4309-cafa-39fddedcc98b"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["_prev: {Value(data=-6.0), Value(data=10.0)}\n","_op: +\n"]}]},{"cell_type":"markdown","source":["## Ver 3 Visualize\n","To Visualize, label and grad are added to Class Value.\n","- label = label\n","- grad = gradient, grad=0 means no effect. At initialization, Value object does not affect output; Gradient 0 means changing of variable does not change loss function."],"metadata":{"id":"eHGca41MtoEf"}},{"cell_type":"code","source":["class Value:\n","  def __init__(self, data, _children=(), _op='', label=''):\n","    \"\"\"\n","    *args\n","      data: data variable\n","      _children: list of previous/parent Value\n","      _op: what operation created this/child Value\n","    \"\"\"\n","    self.data = data\n","    self._prev = set(_children)\n","    self._op = _op\n","    self.grad = 0.0\n","    self.label = label\n","\n","  # Print out a nice looking expression whenever called to print\n","  def __repr__(self):\n","    return f\"Value(data={self.data})\"\n","\n","  def __add__(self, other):\n","    out = Value (self.data + other.data, (self, other), '+')\n","    return out\n","\n","  def __mul__(self,other):\n","    out = Value (self.data * other.data, (self, other), '*')\n","    return out\n","\n","\n","a = Value(2.0, label='a')\n","b = Value(-3.0, label='b')\n","c = Value(10.0, label='c')\n","e = a+b; e.label = 'e'\n","d = a*b + c; d.label = 'd'\n","f = Value(-2.0, label='f')\n","\n","L = d*f; L.label='L'\n","print(L)\n","\n","print(f'_prev: {d._prev}') # Parent Value: (a*b, c)\n","print(f'_op: {d._op}') #"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"pzmU4dMjuivo","executionInfo":{"status":"ok","timestamp":1742440420340,"user_tz":-480,"elapsed":8,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"aa075adb-6359-4f30-ef99-1c753cdab928"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["Value(data=-8.0)\n","_prev: {Value(data=10.0), Value(data=-6.0)}\n","_op: +\n"]}]},{"cell_type":"code","source":["from graphviz import Digraph\n","\n","def trace(root):\n","  # builds a set of all nodes and edges in a graph\n","  nodes, edges = set(), set()\n","  def build(v):\n","    if v not in nodes:\n","      nodes.add(v)\n","      for child in v._prev:\n","        edges.add((child, v))\n","        build(child)\n","  build(root)\n","  return nodes, edges\n","\n","def draw_dot(root):\n","  dot = Digraph(format='svg', graph_attr={'rankdir': 'LR'}) # LR = left to right\n","\n","  nodes, edges = trace(root)\n","  for n in nodes:\n","    uid = str(id(n))\n","    # for any value in the graph, create a rectangular ('record') node for it\n","    dot.node(name = uid, label = \"{ %s | data %.4f | grad %.4f }\" % (n.label, n.data, n.grad), shape='record')\n","    if n._op:\n","      # if this value is a result of some operation, create an op node for it\n","      dot.node(name = uid + n._op, label = n._op)\n","      # and connect this node to it\n","      dot.edge(uid + n._op, uid)\n","\n","  for n1, n2 in edges:\n","    # connect n1 to the op node of n2\n","    dot.edge(str(id(n1)), str(id(n2)) + n2._op)\n","\n","  return dot"],"metadata":{"id":"yEAJy4ltgakF","executionInfo":{"status":"ok","timestamp":1742440420361,"user_tz":-480,"elapsed":21,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}}},"execution_count":9,"outputs":[]},{"cell_type":"code","source":["draw_dot(L)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":211},"id":"7x_0P5BKtr12","executionInfo":{"status":"ok","timestamp":1742440420410,"user_tz":-480,"elapsed":47,"user":{"displayName":"JoyceL U","userId":"15152067095379831731"}},"outputId":"dd587e0a-c536-4e4b-9c86-e94d8c7a2287"},"execution_count":10,"outputs":[{"output_type":"execute_result","data":{"image/svg+xml":"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"no\"?>\n<!DOCTYPE svg PUBLIC \"-//W3C//DTD SVG 1.1//EN\"\n \"http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd\">\n<!-- Generated by graphviz version 2.43.0 (0)\n -->\n<!-- Title: %3 Pages: 1 -->\n<svg width=\"1148pt\" height=\"128pt\"\n viewBox=\"0.00 0.00 1148.00 128.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<g id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(4 124)\">\n<title>%3</title>\n<polygon fill=\"white\" stroke=\"transparent\" points=\"-4,4 -4,-124 1144,-124 1144,4 -4,4\"/>\n<!-- 134920761911824 -->\n<g id=\"node1\" class=\"node\">\n<title>134920761911824</title>\n<polygon fill=\"none\" stroke=\"black\" points=\"635.5,-27.5 635.5,-63.5 820.5,-63.5 820.5,-27.5 635.5,-27.5\"/>\n<text text-anchor=\"middle\" x=\"647\" y=\"-41.8\" font-family=\"Times,serif\" font-size=\"14.00\">d</text>\n<polyline fill=\"none\" stroke=\"black\" points=\"658.5,-27.5 658.5,-63.5 \"/>\n<text text-anchor=\"middle\" x=\"698.5\" y=\"-41.8\" font-family=\"Times,serif\" font-size=\"14.00\">data 4.0000</text>\n<polyline fill=\"none\" stroke=\"black\" points=\"738.5,-27.5 738.5,-63.5 \"/>\n<text text-anchor=\"middle\" x=\"779.5\" y=\"-41.8\" font-family=\"Times,serif\" font-size=\"14.00\">grad 0.0000</text>\n</g>\n<!-- 134920764490448* -->\n<g id=\"node8\" class=\"node\">\n<title>134920764490448*</title>\n<ellipse fill=\"none\" stroke=\"black\" c