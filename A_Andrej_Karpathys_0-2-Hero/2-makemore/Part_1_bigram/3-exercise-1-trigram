itialize the 'network'\n","g = torch.Generator().manual_seed(128128128)\n","W = torch.randn((27, 27), generator=g, requires_grad=True)\n","\n","# Gradient descent\n","steps = 200\n","target1 = int(0.5 * 50)\n","target2 = int(0.75 * 50)\n","\n","for k in range(steps):\n","\n","  # Forward pass\n","  xenc = F.one_hot(xs, num_classes=27).float() # input to the network: one-hot encoding\n","  logits = xenc @ W # predict log-counts\n","  counts = logits.exp() # counts, equivalent to N\n","  probs = counts / counts.sum(1, keepdims=True) # probabilities for next character\n","  loss = -probs[torch.arange(num), ys].log().mean()\n","  # print(loss.item())\n","\n","  # Backward pass\n","  W.grad = None # set to zero the gradient\n","  loss.backward()\n","\n","  # Update\n","  if k >= target2:\n","    W.data += -10 * W.grad\n","  elif k >= target1:\n","    W.data += -20 * W.grad\n","  elif k < target1:\n","    W.data += -100 * W.grad\n","\n","print(loss.item())"],"metadata":{"id":"_FD52TCyN2Yu"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["## Trigram"],"metadata":{"id":"LKJyTRiJN0hH"}},{"cell_type":"markdown","source":["`[chs[i:i+3] for i in range(len(chs)-2)]` -  uses a list comprehension to generate slices of three consecutive characters from chs.\n","\n","The slicing is done such that `chs[i:i+3]` extracts a substring of length 3 starting at index i. This ensures that you cover all possible trigrams, including those near the boundaries."],"metadata":{"id":"UVSS8_lQf4T2"}},{"cell_type":"code","source":["# Create the dataset\n","xs1, xs2, ys = [], [], []\n","for w in words:\n","  chs = ['.'] + list(w) + ['.']\n","  for i in range(len(chs) - 2):\n","    ch1, ch2, ch3 = chs[i], chs[i+1], chs[i+2]\n","    ix1 = stoi[ch1]\n","    ix2 = stoi[ch2]\n","    ix3 = stoi[ch3]\n","    xs1.append(ix1)\n","    xs2.append(ix2)\n","    ys.append(ix3)\n","\n","xs1 = torch.tensor(xs1)\n","xs2 = torch.tensor(xs2)\n","ys = torch.tensor(ys)\n","num = xs1.nelement()\n","