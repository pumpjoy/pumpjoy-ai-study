        <mxCell id="SlxCUwX7jWrc0gDs0Zcw-38" value="&lt;div align=&quot;left&quot;&gt;Advantages:&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;- offer precise feedback by identifying specific location of errors &lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;(valuable signal for reinforcement learning and automatic correction)&lt;br&gt;- mirrors human judgement when assessing reasoning problem&lt;/font&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="0fS1D7rZX_UYe2vZsyNV-9">
          <mxGeometry x="352.5" y="310" width="175" height="110" as="geometry" />
        </mxCell>
        <mxCell id="k1mLTlJ9wKKj0YE3iCsP-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="0fS1D7rZX_UYe2vZsyNV-9" source="k1mLTlJ9wKKj0YE3iCsP-2" target="k1mLTlJ9wKKj0YE3iCsP-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k1mLTlJ9wKKj0YE3iCsP-2" value="&lt;div align=&quot;center&quot;&gt;Issues:&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Gathering data for PRM is expensive and requires advance annotator skills&lt;/font&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="0fS1D7rZX_UYe2vZsyNV-9">
          <mxGeometry x="140" y="340" width="175" height="50" as="geometry" />
        </mxCell>
        <mxCell id="k1mLTlJ9wKKj0YE3iCsP-8" value="Proposal: Automatic process annotation framework&lt;br&gt;&lt;p&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;- Inspired by Monte Carlo Tree Search&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;- Define the quality of intermediate step to deduce correct final answer&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;- Leverage correctness of answer, automatically gather step-wise supervision&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Given a math problem with golden answer and step-by-step solution, to achieve label of specific step, &lt;br&gt;a fine-tuned LLM is utilized to decode multiple subsequent reasoning paths&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;- Validate whether decoded final answer matches with golden answer&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;- If a reasoning step can deduce more correct answers than another, it will be assigned a higher correctness score&lt;br&gt;&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="0fS1D7rZX_UYe2vZsyNV-9">
          <mxGeometry x="10" y="430" width="290" height="330" as="geometry" />
        </mxCell>
        <mxCell id="k1mLTlJ9wKKj0YE3iCsP-10" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" vertex="1" parent="0fS1D7rZX_UYe2vZsyNV-9">
          <mxGeometry x="315" y="430" width="373" height="166.87" as="geometry" />
        </mxCell>
        <UserObject label="&lt;div align=&quot;left&quot;&gt;https://achieved-bellflower-4d6.notion.site/Math-Shepherd-Verify-and-Reinforce-LLMs-Step-by-step-without-Human-Annotations-41b6e73c860840e08697d347f8889bac&lt;/div&gt;" link="https://achieved-bellflower-4d6.notion.site/Math-Shepherd-Verify-and-Reinforce-LLMs-Step-by-step-without-Human-Annotations-41b6e73c860840e08697d347f8889bac" id="0fS1D7rZX_UYe2vZsyNV-11">
          <mxCell style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="0fS1D7rZX_UYe2vZsyNV-9">
            <mxGeometry x="330" y="620" width="60" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="k1mLTlJ9wKKj0YE3iCsP-6" value="&lt;h1 align=&quot;center&quot; style=&quot;margin-top: 0px;&quot;&gt;Chain of Thoughts&lt;br&gt;&lt;/h1&gt;&lt;p align=&quot;center&quot;&gt;https://arxiv.org/pdf/2201.11903&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;align=center;" vertex="1" parent="1">
          <mxGeometry x="-590" y="673.13" width="230" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
